index 73083d3..6631bdc 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -2096,8 +2096,32 @@ static void pd_note(const u32* targets, u32 n_targets, u32 zslot,
 /* Called on every present: arm on the first frame heavy enough when no delay
  * was asked for, and while capturing, close the pass in progress and write
  * the presented surface. */
+/* RSX_ENGINE_SNAP_DIR=<dir>, RSX_ENGINE_SNAP_EVERY_S=<n>: write the presented surface to
+ * <dir>/snap_<seconds since the first present>.ppm every n seconds (default 5), for following a
+ * run that cannot be watched. */
+static void pd_snapshot(u32 presented)
+{
+    static const char* dir = (const char*)-1;
+    static double every = 5.0;
+    static time_t t0, last;
+    if (dir == (const char*)-1) {
+        dir = getenv("RSX_ENGINE_SNAP_DIR");
+        const char* e = getenv("RSX_ENGINE_SNAP_EVERY_S");
+        if (e && atof(e) > 0.0) every = atof(e);
+    }
+    if (!dir || !*dir || presented == ENG_INVALID) return;
+    const time_t now = time(NULL);
+    if (!t0) { t0 = now; last = now - (time_t)every; }
+    if (difftime(now, last) < every) return;
+    last = now;
+    char path[1024];
+    snprintf(path, sizeof path, "%s/snap_%04ld.ppm", dir, (long)(now - t0));
+    pd_write_surface(presented, path);
+}
+
 static void pd_present(u32 presented)
 {
+    pd_snapshot(presented);
     if (s_pd.state == 0) pd_capturing();
