+static int SDLCALL pad_sdl_thread(void* unused)
+{
+    (void)unused;
+    int ok = SDL_WasInit(SDL_INIT_GAMECONTROLLER) != 0 ||
+             SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER) == 0;
+    if (!ok)
+        fprintf(stderr, "[cellPad] SDL gamecontroller init failed: %s\n", SDL_GetError());
+
+    while (!s_sdl_stop) {
+        if (ok) pad_sdl_sweep();
+        if (s_sdl_ready) {   /* the first sweep has opened the controllers present at start */
+            SDL_SemPost(s_sdl_ready);
