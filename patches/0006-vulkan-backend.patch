Vulkan RSX backend on Windows.

- The D3D12 backend has only the old live-draw path, which draws the scene into a supersampled target it never
  resolves (a black picture after the intro). The Vulkan backend runs the register-file draw engine, as Metal does,
  so it is built for Windows too with PS3RECOMP_RSX_VULKAN: vulkan-1.dll through LoadLibrary, SDL2 (static) for the
  window, glslang for the guest programs. D3D12 stays in the build as the fallback.
- Batching the engine's submissions (the part of this patch that used to be the bulk of it) is the toolkit's since
  v0.18.0: VK_DRAW_BATCH=1 (#532, #552); main.cpp turns it on.

---

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c333473c..e6065c67 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -47,11 +47,11 @@ list(FILTER HLE_SOURCES EXCLUDE REGEX "/tests/")
 # The Vulkan RSX backend is opt-in while it grows (stage V0: clear + present).
 # It loads libvulkan at run time, so building needs only the Vulkan headers --
 # no target-architecture libvulkan, which keeps cross-compiling simple.
-option(PS3RECOMP_RSX_VULKAN "Build the Vulkan RSX backend (Linux)" OFF)
+option(PS3RECOMP_RSX_VULKAN "Build the Vulkan RSX backend (Linux, Windows)" OFF)
 list(FILTER HLE_SOURCES EXCLUDE REGEX "rsx_vulkan_backend\\.c$")
 if(PS3RECOMP_RSX_VULKAN)
-    if(WIN32 OR APPLE)
-        message(FATAL_ERROR "PS3RECOMP_RSX_VULKAN is Linux-only for now")
+    if(APPLE)
+        message(FATAL_ERROR "PS3RECOMP_RSX_VULKAN is for Linux and Windows")
     endif()
     find_path(PS3RECOMP_VULKAN_INCLUDE_DIR vulkan/vulkan.h)
     if(NOT PS3RECOMP_VULKAN_INCLUDE_DIR)
@@ -181,6 +181,15 @@ if(PS3RECOMP_RSX_VULKAN)
     # PUBLIC: ps3recomp_host selects its backend on this definition.
     target_compile_definitions(ps3recomp_runtime PUBLIC PS3RECOMP_RSX_VULKAN)
     target_link_libraries(ps3recomp_runtime PUBLIC ${CMAKE_DL_LIBS})
+    if(WIN32)
+        # Off Windows SDL2 is already linked for cellPad/cellAudio; on Windows only the Vulkan window needs it.
+        find_package(SDL2 REQUIRED)
+        if(TARGET SDL2::SDL2-static)
+            target_link_libraries(ps3recomp_runtime PUBLIC SDL2::SDL2-static)
+        else()
+            target_link_libraries(ps3recomp_runtime PUBLIC SDL2::SDL2)
+        endif()
+    endif()
     message(STATUS "  Vulkan:       RSX backend enabled (rsx_vulkan_backend.c, headers in ${PS3RECOMP_VULKAN_INCLUDE_DIR})")
 endif()
 
@@ -221,6 +230,9 @@ endif()
 #           the standalone binary as an imported target and fails to load
 #           without it)
 set(PS3RECOMP_MSL_TRANSLATION OFF)
+if(WIN32 AND PS3RECOMP_RSX_VULKAN)
+    find_package(glslang CONFIG QUIET)
+endif()
 if(UNIX)
     find_package(glslang CONFIG QUIET)
 
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index db64302e..64240160 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -2,7 +2,7 @@
  * ps3recomp - Vulkan RSX Backend. See rsx_vulkan_backend.h.
  *
  * The file, in order:
- *   loader and device      libvulkan by dlopen, Vulkan 1.0 entry points only;
+ *   loader and device      libvulkan by dlopen (vulkan-1.dll on Windows), Vulkan 1.0 entry points only;
  *                          device choice, BC textures when the device has them
  *   memory, images, submit helpers
  *   vtable fallback path   the null backend's fixed-function contract:
@@ -38,7 +38,9 @@
  * with spaces.
  */
 
-#ifndef _WIN32
+/* Windows also has the D3D12 backend, but that one has only the old live-draw path; with PS3RECOMP_RSX_VULKAN
+ * this one is built there too (vulkan-1.dll), so a title that needs the draw engine has a backend on Windows. */
+#if !defined(_WIN32) || defined(PS3RECOMP_RSX_VULKAN)
 
 #define VK_NO_PROTOTYPES
 #include <vulkan/vulkan.h>
@@ -58,7 +60,20 @@
 #include <SDL2/SDL.h>
 #include <SDL2/SDL_vulkan.h>
 
-#include <dlfcn.h>
+#ifdef _WIN32
+#  define WIN32_LEAN_AND_MEAN
+#  include <windows.h>
+#  define vk_dlopen(name)     ((void*)LoadLibraryA(name))
+#  define vk_dlsym(lib, name) ((void*)GetProcAddress((HMODULE)(lib), (name)))
+#  define vk_dlclose(lib)     FreeLibrary((HMODULE)(lib))
+#  define vk_dlerror()        "LoadLibrary failed"
+#else
+#  include <dlfcn.h>
+#  define vk_dlopen(name)     dlopen((name), RTLD_NOW | RTLD_LOCAL)
+#  define vk_dlsym(lib, name) dlsym((lib), (name))
+#  define vk_dlclose(lib)     dlclose(lib)
+#  define vk_dlerror()        dlerror()
+#endif
 #include <pthread.h>
 #include <stddef.h>
 #include <stdint.h>
@@ -251,15 +266,19 @@ static vk_state s_vk;
  * -------------------------------------------------------------------------*/
 static int vk_load_library(void)
 {
+#ifdef _WIN32
+    static const char* names[] = { "vulkan-1.dll" };
+#else
     static const char* names[] = { "libvulkan.so.1", "libvulkan.so" };
+#endif
     for (size_t i = 0; i < sizeof names / sizeof names[0] && !s_vk.lib; i++)
-        s_vk.lib = dlopen(names[i], RTLD_NOW | RTLD_LOCAL);
+        s_vk.lib = vk_dlopen(names[i]);
     if (!s_vk.lib) {
-        VK_LOG("no Vulkan loader found (dlopen libvulkan.so.1: %s)\n", dlerror());
+        VK_LOG("no Vulkan loader found (%s: %s)\n", names[0], vk_dlerror());
         return -1;
     }
     pvkGetInstanceProcAddr =
-        (PFN_vkGetInstanceProcAddr)dlsym(s_vk.lib, "vkGetInstanceProcAddr");
+        (PFN_vkGetInstanceProcAddr)vk_dlsym(s_vk.lib, "vkGetInstanceProcAddr");
     if (!pvkGetInstanceProcAddr) { VK_LOG("libvulkan has no vkGetInstanceProcAddr\n"); return -1; }
 #define LOAD_G(name) \
     if (!(p##name = (PFN_##name)pvkGetInstanceProcAddr(VK_NULL_HANDLE, #name))) \
@@ -4018,7 +4037,7 @@ void rsx_vulkan_backend_shutdown(void)
         pvkDestroyDevice(s_vk.device, NULL);
     }
     if (s_vk.instance && pvkDestroyInstance) pvkDestroyInstance(s_vk.instance, NULL);
-    if (s_vk.lib) dlclose(s_vk.lib);
+    if (s_vk.lib) vk_dlclose(s_vk.lib);
     free(s_vk.cpu_verts);
     pthread_mutex_destroy(&s_vk.queue_mu);
     pthread_mutex_destroy(&s_vk.present_mu);
@@ -4083,4 +4102,4 @@ int rsx_vulkan_backend_depth_bounds(void)
     return s_vk.eng_active && s_vk.depth_bounds_ok;
 }
 
-#endif /* !_WIN32 */
+#endif /* !_WIN32 || PS3RECOMP_RSX_VULKAN */
