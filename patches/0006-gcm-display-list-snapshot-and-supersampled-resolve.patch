+++ b/libs/video/rsx_draw_engine.c
@@ -716,6 +716,66 @@ void rsx_draw_engine_guest_read(u32 location, u32 offset, u32 pitch, u32 w, u32
     }
 }
 
+/* A scaled NV3089 blit out of a supersampled colour surface (a resolve). The host renders the
+ * surface at display size (w x h) while the guest laid it out k times wider and taller
+ * (pitch = 4 * k * w, k * h rows, often split over several address ranges), so the k:1 downsample
+ * the guest asks for is a 1:1 copy in host pixels: the output pixel at (x, y) is the host pixel at
+ * (guest position / k + x, ... + y). Copying the host pixels into the guest layout first, as
+ * rsx_draw_engine_guest_read does, would put a display-sized picture into the top left corner of
+ * the k-times-larger layout and the downsample would then keep only its top left quarter.
+ * Writes the resolved rectangle straight into the destination in guest memory (32-bit pixels).
+ * Returns 0 when the source is not such a surface (the caller falls back to the guest-memory
+ * copy). */
+int rsx_draw_engine_resolve_read(u32 src_loc, u32 src_offset, u32 src_pitch, u32 ds, u32 dt,
+                                 u32 dst_loc, u32 dst_offset, u32 dst_pitch, u32 out_w, u32 out_h)
+{
+    if (!g.ready || !g.be->readback || !src_pitch || !dst_pitch || !out_w || !out_h) return 0;
+    if (ds != dt || ds < 0x200000u || (ds & 0xFFFFFu)) return 0;     /* whole factor >= 2 */
+    const u32 k = ds >> 20;
+    u32 slot = ENG_INVALID, gx = 0, gy = 0;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        const eng_surface* s = &g.surfaces[i];
+        if (!s->handle || s->location != src_loc || src_offset < s->offset) continue;
+        if (s->fmt != RSX_BE_FMT_R8G8B8A8 || s->pitch != src_pitch || src_pitch != 4u * k * s->w) continue;
+        const u32 d = src_offset - s->offset;
+        if (d / src_pitch >= k * s->h || (d % src_pitch) / 4u >= k * s->w) continue;
+        if (slot != ENG_INVALID && g.surfaces[slot].offset > s->offset) continue;
+        slot = i; gx = (d % src_pitch) / 4u; gy = d / src_pitch;
+    }
+    if (slot == ENG_INVALID) return 0;
+    const eng_surface* s = &g.surfaces[slot];
+    const u32 sx = gx / k, sy = gy / k;
+    if (sx >= s->w || sy >= s->h) return 1;                           /* beyond the picture: nothing to copy */
+    u32 w = out_w, h = out_h;
+    if (sx + w > s->w) w = s->w - sx;
+    if (sy + h > s->h) h = s->h - sy;
+    u8* rows = eng_coherence_buffer(w * 4u * h);
+    if (!rows) return 0;
+    g.be->submit_and_wait(g.be->user, RSX_BE_FLUSH_GUEST_REFERENCE);
+    g.be->readback(g.be->user, s->handle, sx, sy, w, h, rows, w * 4u);
+    if (eng_coherence_log())
+        fprintf(stderr, "[rsx engine] resolve_read %u:0x%08X k=%u %ux%u <- surface 0x%08X at %u,%u: %u non-zero pixels\n",
+                src_loc, src_offset, k, w, h, s->offset, sx, sy, eng_nonzero_pixels(rows, w * h));
+    const int rgba = rsx_texture_argb_is_rgba();
+    for (u32 r = 0; r < h; r++) {
+        u8* dst = (u8*)eng_guest_ptr(NULL, dst_loc, dst_offset + r * dst_pitch, w * 4u);
+        if (!dst) return 1;
+        const u8* src = rows + (size_t)r * w * 4u;
+        for (u32 c = 0; c < w; c++, src += 4, dst += 4) {
+            if (rgba) { dst[0] = src[0]; dst[1] = src[1]; dst[2] = src[2]; dst[3] = src[3]; }
+            else      { dst[0] = src[3]; dst[1] = src[0]; dst[2] = src[1]; dst[3] = src[2]; }
+        }
+    }
+    /* Cached textures that contain the written rectangle are re-hashed on their next use. */
+    for (u32 i = 0; i < g.n_textures; i++) {
+        eng_texture* e = &g.textures[i];
+        if (e->location == dst_loc && e->offset <= dst_offset && dst_offset - e->offset < 0x800000u) {
+            e->last_hash_frame = g.frames - 1u;
+        }
+    }
+    return 1;
+}
+
 void rsx_draw_engine_guest_wrote(u32 location, u32 offset, u32 pitch, u32 w, u32 h)
 {
     if (!g.ready || !g.be->color_target_write || !pitch || !w || !h) return;
