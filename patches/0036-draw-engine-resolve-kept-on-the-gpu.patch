+/* ---- resolves kept on the GPU ------------------------------------------- */
+/*
+ * A title resolving its supersampled scene into VRAM every frame and drawing
+ * the result to the screen with one full-screen pass used to cost a whole
+ * readback of the scene, its store into guest memory, and a re-hash, decode and
+ * upload of the same pixels as a texture -- with the GPU idle while the frame
+ * thread waited for it. Instead the resolved pixels are copied on the GPU into a
+ * colour target the engine keeps for that guest range (eng_resolve), and a
+ * texture unit naming exactly that image samples the target. Guest memory gets
+ * the pixels only when something else reads those bytes through the engine: a
+ * texture of another shape or format, a 2D transfer, a surface store. What it
+ * cannot see is the CPU reading them directly; RSX_ENGINE_GPU_RESOLVE=0 keeps
+ * the old store of every resolve for a title that does.
+ */
+
+static int eng_gpu_resolve_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_ENGINE_GPU_RESOLVE"); on = !(e && e[0] == '0'); }
+    return on && g.be->color_target_copy && g.be->readback;
+}
+
+static int eng_resolve_overlaps(const eng_resolve* r, u32 location, u32 offset, u32 bytes)
+{
+    if (!r->handle || r->location != location || !bytes) return 0;
+    const u64 lo = r->offset, hi = lo + (u64)r->pitch * r->h;
+    return (u64)offset < hi && (u64)offset + bytes > lo;
+}
+
+/* Cached textures that may cover [offset, offset + bytes) are re-hashed on their next use; a texture's span is not
+ * kept, so one starting up to 8 MB below counts. */
+static void eng_textures_rehash(u32 location, u32 offset, u32 bytes)
+{
+    for (u32 i = 0; i < g.n_textures; i++) {
+        eng_texture* e = &g.textures[i];
+        if (e->location != location) continue;
+        if (e->offset >= offset ? e->offset - offset < bytes : offset - e->offset < 0x800000u)
+            e->last_hash_frame = g.frames - 1u;
+    }
+}
+
+/* Store a resolve's pending rectangles into guest memory, laid out as the CPU copy of the resolve leaves them. */
+static void eng_resolve_to_guest(eng_resolve* r)
+{
+    if (!r->n_rects) return;
+    u32 x0 = r->w, y0 = r->h, x1 = 0, y1 = 0;
+    for (u32 i = 0; i < r->n_rects; i++) {
+        const eng_rect* q = &r->rects[i];
+        if (q->x < x0) x0 = q->x;
+        if (q->y < y0) y0 = q->y;
+        if (q->x + q->w > x1) x1 = q->x + q->w;
+        if (q->y + q->h > y1) y1 = q->y + q->h;
+    }
+    const u32 bw = x1 - x0, bh = y1 - y0;
+    u8* rows = eng_coherence_buffer(bw * 4u * bh);
+    if (rows) {
+        g.be->submit_and_wait(g.be->user, RSX_BE_FLUSH_GUEST_REFERENCE);
+        g.be->readback(g.be->user, r->handle, x0, y0, bw, bh, rows, bw * 4u);
+        const int rgba = rsx_texture_argb_is_rgba();
+        for (u32 i = 0; i < r->n_rects; i++) {
+            const eng_rect* q = &r->rects[i];
+            for (u32 y = 0; y < q->h; y++) {
+                u8* dst = (u8*)eng_guest_ptr(NULL, r->location,
+                                             r->offset + (q->y + y) * r->pitch + q->x * 4u, q->w * 4u);
+                if (!dst) break;
+                const u8* src = rows + ((size_t)(q->y - y0 + y) * bw + (q->x - x0)) * 4u;
+                for (u32 c = 0; c < q->w; c++, src += 4, dst += 4) {
+                    if (rgba) { dst[0] = src[0]; dst[1] = src[1]; dst[2] = src[2]; dst[3] = src[3]; }
+                    else      { dst[0] = src[3]; dst[1] = src[0]; dst[2] = src[1]; dst[3] = src[2]; }
+                }
+            }
+        }
+        if (eng_coherence_log())
+            fprintf(stderr, "[rsx engine] resolve %u:0x%08X %ux%u stored to guest memory (%u rectangles)\n",
+                    r->location, r->offset, r->w, r->h, r->n_rects);
+    }
+    r->n_rects = 0;
+    eng_textures_rehash(r->location, r->offset, r->pitch * r->h);
+}
+
+/* Bring guest memory up to date with every resolve kept on the GPU that overlaps [offset, offset + bytes). */
+static void eng_resolves_sync(u32 location, u32 offset, u32 bytes)
+{
+    for (u32 i = 0; i < g.n_resolves; i++)
+        if (g.resolves[i].n_rects && eng_resolve_overlaps(&g.resolves[i], location, offset, bytes))
+            eng_resolve_to_guest(&g.resolves[i]);
+}
+
+void rsx_draw_engine_guest_access(u32 location, u32 offset, u32 bytes)
+{
+    if (g.ready) eng_resolves_sync(location, offset, bytes);
+}
+
+static void eng_resolve_drop(eng_resolve* r)
+{
+    eng_resolve_to_guest(r);
+    if (r->handle) g.be->color_target_release(g.be->user, r->handle);
+    memset(r, 0, sizeof *r);
+}
+
+/* The resolve for this guest image, created when new. Any other one overlapping its bytes is stored and dropped
+ * first: two GPU copies of one range could not both be current. NULL when no target could be made. */
+static eng_resolve* eng_resolve_get(u32 location, u32 offset, u32 pitch, u32 w, u32 h)
+{
+    for (u32 i = 0; i < g.n_resolves; i++) {
+        eng_resolve* r = &g.resolves[i];
+        if (r->handle && r->location == location && r->offset == offset && r->pitch == pitch &&
+            r->w == w && r->h == h)
+            return r;
+    }
+    eng_resolve* slot = NULL;
+    for (u32 i = 0; i < g.n_resolves; i++) {
+        eng_resolve* r = &g.resolves[i];
+        if (r->handle && !eng_resolve_overlaps(r, location, offset, pitch * h)) continue;
+        eng_resolve_drop(r);
+        if (!slot) slot = r;
+    }
+    if (!slot) {
+        slot = &g.resolves[g.n_resolves < ENG_MAX_RESOLVES ? g.n_resolves++ : 0];
+        eng_resolve_drop(slot);
+    }
+    const u32 handle = g.be->color_target_create(g.be->user, RSX_BE_FMT_R8G8B8A8, w, h, NULL, 0);
+    if (!handle) return NULL;
+    slot->location = location; slot->offset = offset; slot->pitch = pitch;
+    slot->w = w; slot->h = h;
+    slot->handle = handle;
+    slot->n_rects = 0;
+    { static u32 logs = 0; if (logs++ < 8)
+        fprintf(stderr, "[rsx engine] resolve %u:0x%08X %ux%u (pitch %u) kept on the GPU\n",
+                location, offset, w, h, pitch); }
+    return slot;
+}
+
+static u64 eng_resolve_area(const eng_resolve* r)
+{
+    u64 a = 0;
+    for (u32 i = 0; i < r->n_rects; i++) a += (u64)r->rects[i].w * r->rects[i].h;
+    return a;
+}
+
+/* Before rectangle q of a resolve is copied in: 1 when q must then be added to the pending ones, 0 when they
+ * already cover it. Pending rectangles q only partly overlaps are stored into guest memory first, so the set stays
+ * disjoint and exact (what is pending is always newer on the GPU than in guest memory). */
+static int eng_resolve_prepare(eng_resolve* r, const eng_rect* q)
+{
+    if (eng_resolve_area(r) == (u64)r->w * r->h) return 0;      /* all of it is pending */
+    for (u32 i = 0; i < r->n_rects; i++) {
+        const eng_rect* p = &r->rects[i];
+        if (q->x >= p->x && q->y >= p->y && q->x + q->w <= p->x + p->w && q->y + q->h <= p->y + p->h)
+            return 0;
+        if (q->x < p->x + p->w && p->x < q->x + q->w && q->y < p->y + p->h && p->y < q->y + q->h) {
+            eng_resolve_to_guest(r);
+            return 1;
+        }
+    }
+    if (r->n_rects >= ENG_MAX_RESOLVE_RECTS) eng_resolve_to_guest(r);
+    return 1;
+}
+
+/* A texture unit reading a resolve kept on the GPU exactly as it is laid out -- linear A8R8G8B8 at its address and
+ * pitch, its size, one level -- with all of it resolved: the picture itself, through the unit's crossbar. 0 for
+ * anything else, which eng_texture_slot then reads from guest memory, storing the resolve there first. */
+static u32 eng_resolve_texture(const rsx_dsp_texture* t)
+{
+    const u32 base_fmt = t->format & RSX_TEX_FMT_BASE_MASK & ~(u32)RSX_TEX_FMT_UNNORM;
+    if (base_fmt != RSX_TEX_FMT_A8R8G8B8 || !(t->format & RSX_TEX_FMT_LINEAR) || t->cubemap || t->mipmaps > 1)
+        return 0;
+    for (u32 i = 0; i < g.n_resolves; i++) {
+        const eng_resolve* r = &g.resolves[i];
+        if (!r->handle || !r->n_rects || r->location != t->location || r->offset != t->offset ||
+            r->pitch != t->pitch || r->w != t->width || r->h != t->height)
+            continue;
+        if (eng_resolve_area(r) != (u64)r->w * r->h) return 0;
+        const u32 view = g.be->surface_view
+            ? g.be->surface_view(g.be->user, r->handle, t->remap & 0xFFFFu, t->format) : 0;
+        return view ? view : r->handle;
+    }
+    return 0;
+}
