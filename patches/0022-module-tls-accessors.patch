Lifted code built as a separate module: reach the thread-local trampoline state through accessors.

A dll/dylib cannot import a thread-local variable from the host (Mach-O and PE linkers reject it). With
SPU_MODULE_ACCESSORS / PPU_MODULE_ACCESSORS defined, spu_context.h and the lifter-emitted chunk prologue map the
trampoline variables onto accessor functions that the host runtime exports. Without the macros nothing changes.

---
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -768,6 +768,17 @@
  * function in the active image and runs it. Referenced by SPU_RET/SPU_DRAIN. */
 void spu_indirect_branch(spu_context* ctx);
 
+#ifdef SPU_MODULE_ACCESSORS
+/* Lifted images built as a separate loadable module (dll/dylib/so) cannot import the thread-local
+ * variables below: the Mach-O and PE linkers reject a TLS reference to a symbol in another image.
+ * The host exports one accessor per variable (spu_drain.c) and the module reaches them through it. */
+void (**spu_tramp_slot(void))(spu_context*);
+uint32_t (*spu_pch_arr(void))[8];
+unsigned *spu_pch_n_slot(void);
+#  define g_spu_trampoline_fn (*spu_tramp_slot())
+#  define g_spu_pch           (*spu_pch_arr())
+#  define g_spu_pch_n         (*spu_pch_n_slot())
+#else
 /* Pending cross-function transfer target; NULL when none. Thread-local: each
  * spu_context is pinned to one host thread for its lifetime. */
 extern SPU_THREAD_LOCAL void (*g_spu_trampoline_fn)(spu_context*);
@@ -777,6 +788,7 @@
  * trampoline hop, which is the one that actually precedes a bad branch. */
 extern SPU_THREAD_LOCAL uint32_t g_spu_pch[8];
 extern SPU_THREAD_LOCAL unsigned g_spu_pch_n;
+#endif
 
 /* Central per-transfer hooks (stubbed in spu_drain.c until their milestones). */
 void yz_lockstep_tick(spu_context* ctx);             /* round-robin token gate */
--- a/runtime/spu/spu_drain.c
+++ b/runtime/spu/spu_drain.c
@@ -21,6 +21,11 @@
 SPU_THREAD_LOCAL uint32_t g_spu_pch[8];
 SPU_THREAD_LOCAL unsigned g_spu_pch_n;
 
+/* Accessors for lifted images built as a separate module (see SPU_MODULE_ACCESSORS in spu_context.h). */
+void (**spu_tramp_slot(void))(spu_context*) { return &g_spu_trampoline_fn; }
+uint32_t (*spu_pch_arr(void))[8] { return &g_spu_pch; }
+unsigned *spu_pch_n_slot(void) { return &g_spu_pch_n; }
+
 /* yz_lockstep_tick now has its real body in spu_lockstep.c (milestone 2). */
 
 /* SPURS task-launch interception at a trampoline hop (milestone: SPURS kernel).
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -1937,6 +1937,9 @@
 
 /* Cross-fragment trampoline pointer (matches the lifted header's TLS decl). */
 extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*) = nullptr;
+/* The slot for a lift built as a separate module, which cannot import a TLS variable (see PPU_MODULE_ACCESSORS
+ * in the lifter's chunk prologue). */
+extern "C" void (**ppu_tramp_slot(void))(void*) { return &g_trampoline_fn; }
 
 /* Per-thread active guest context, for the crash handler to report the guest PC
  * (ctx->pc, updated by lifted code at block boundaries) of a host AV. */
--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -338,8 +338,16 @@
 extern "C" void ps3_hle_call(unsigned int nid, ppu_context* ctx);
 
 /* Trampoline function pointer for cross-fragment branches (TLS).
- * PPU_THREAD_LOCAL comes from ppu_recomp.h, included above. */
+ * PPU_THREAD_LOCAL comes from ppu_recomp.h, included above.
+ * A lift built as a separate loadable module (PPU_MODULE_ACCESSORS) cannot import a thread-local
+ * variable from the host (Mach-O and PE linkers reject it), so it reaches the host's slot through
+ * an exported accessor instead. */
+#ifdef PPU_MODULE_ACCESSORS
+extern "C" void (**ppu_tramp_slot(void))(void*);
+#  define g_trampoline_fn (*ppu_tramp_slot())
+#else
 extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*);
+#endif
 
 /* Drain pending trampolines after any call that might set g_trampoline_fn.
  * Converts cross-fragment fallthrough chains into iterative loops. */
