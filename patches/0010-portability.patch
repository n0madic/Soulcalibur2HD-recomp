+/* Accessors for lifted images built as a separate module (see SPU_MODULE_ACCESSORS in spu_context.h). */
+void (**spu_tramp_slot(void))(spu_context*) { return &g_spu_trampoline_fn; }
+uint32_t (*spu_pch_arr(void))[8] { return &g_spu_pch; }
