D3D12: key the per-draw vertex program cache on the program, not on the store behind it.

vp_get_vs hashed the microcode from SET_TRANSFORM_PROGRAM_START to the end of everything ever uploaded. A title that
keeps several programs resident and uploads others behind the one it draws with changes that hash on every upload,
so nearly every draw missed the cache and ran D3DCompile on the FIFO thread: Soulcalibur II HD on Windows fell to
about one frame a second after the intro, and its audio engine, fed from the same frame loop, starved. The hash now
ends at the program's end bit, as the Metal backend's does, and the cache holds 128 programs instead of 16.

---
diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index b7d2ae1..a690611 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -184,11 +184,12 @@ typedef struct {
     ID3DBlob* vs;
     int uses_c03;
 } VPVSEntry;
-#define VP_VS_CACHE 16  /* wave uses 5+ distinct VPs; at 4 the cache
+#define VP_VS_CACHE 128 /* wave uses 5+ distinct VPs; at 4 the cache
                          * thrashed every frame and eviction shifted slots
                          * under recorded vs_idx values -- the display mesh
                          * drew with the WRONG vertex program (sub-rect +
-                         * edge slivers instead of fullscreen) */
+                         * edge slivers instead of fullscreen). Soulcalibur II
+                         * HD draws a fight with more than 16. */
 
 /* Compiled guest-FP pipeline cache: decompiled VS (by cache slot) + decompiled
  * PS (fragment ucode at fp_addr). */
@@ -1745,6 +1746,14 @@ static int vp_get_vs(const rsx_state* st)
     if (vstart >= st->vp_ucode_bytes) vstart = 0;
     const u8* vuc = st->vp_ucode + vstart;
     u32 vlen = st->vp_ucode_bytes - vstart;
+    /* Hash the program's own bytes, to its end bit, not everything after it
+     * in the store (as the Metal backend does): a title that keeps several
+     * programs resident and uploads others behind the one it draws with
+     * changed the hash on every upload, so nearly every draw missed and ran
+     * D3DCompile on the FIFO thread -- about one frame a second. */
+    { extern u32 rsx_vp_program_size_instrs(const u8*, u32);
+      const u32 instrs = rsx_vp_program_size_instrs(vuc, vlen);
+      if (instrs) vlen = instrs * 16u; }
     u32 hash = vp_hash_ucode(vuc, vlen);
     for (int i = 0; i < s_d3d.vp_vs_n; i++)
         if (s_d3d.vp_vs[i].hash == hash) return i;
