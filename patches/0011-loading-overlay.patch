+/* The "Loading..." overlay (PS3RECOMP_LOADING_OVERLAY=1): a title spends its first seconds clearing and fading
+ * in black while it loads, and the window shows nothing meanwhile. The backends draw the text into their window
+ * present while rsx_draw_engine_loading_overlay() is true. It ends with the first presented frame that has a lit
+ * pixel in it, or after ENG_LOADING_MAX_FRAMES frames: a title that never shows a picture keeps no overlay forever. */
+#define ENG_LOADING_OFF        0
+#define ENG_LOADING_SHOW       1
+#define ENG_LOADING_DONE       2
+#define ENG_LOADING_MAX_FRAMES 3600
+#define ENG_LOADING_LIT        8      /* a channel above this is picture, not black */
+
+/* Is there picture on this surface? Three pixels, flushed first so they hold what the guest has drawn so far. */
+static int eng_picture_started(const eng_surface* s)
+{
+    if (s->fmt != RSX_BE_FMT_R8G8B8A8 || !s->w || !s->h || !g.be->readback || !g.be->submit_and_wait) return 1;
+    g.be->submit_and_wait(g.be->user, RSX_BE_FLUSH_GUEST_REFERENCE);
+    const u32 xs[3] = { s->w / 2u, s->w / 8u, s->w - 1u - s->w / 8u };
+    const u32 ys[3] = { s->h / 2u, s->h / 8u, s->h - 1u - s->h / 8u };
+    for (u32 i = 0; i < 3; i++) {
+        u8 px[4] = { 0, 0, 0, 0 };
+        g.be->readback(g.be->user, s->handle, xs[i], ys[i], 1, 1, px, 4);
+        if (px[0] > ENG_LOADING_LIT || px[1] > ENG_LOADING_LIT || px[2] > ENG_LOADING_LIT) return 1;
+    }
+    return 0;
+}
+
+int rsx_draw_engine_loading_overlay(void)
+{
+    return g.loading == ENG_LOADING_SHOW;
+}
