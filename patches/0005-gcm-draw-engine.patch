+/* GCM_SNAPSHOT_CALLS=1: called lists are copied (when published, and again when walked). */
+static int gcm_snapshot_calls(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("GCM_SNAPSHOT_CALLS") ? 1 : 0;
+    return on;
