+/* LS call hooks: host code that stands in for a module a title loads into local
+ * store at runtime (a DSP .pic). The hook runs instead of interpreting the code
+ * at (image_id, pc); it receives the registers as at the call, does the work
+ * and leaves ctx->pc at the return address, like the real function's `bi $r0`. */
+#define SPU_LS_HOOK_MAX 16
+static struct { int image_id; uint32_t pc; spu_ls_hook_fn fn; } s_ls_hooks[SPU_LS_HOOK_MAX];
+static int s_ls_hook_count;
+
+void spu_register_ls_hook(int image_id, uint32_t pc, spu_ls_hook_fn fn)
+{
+    if (s_ls_hook_count < SPU_LS_HOOK_MAX) {
+        s_ls_hooks[s_ls_hook_count].image_id = image_id;
+        s_ls_hooks[s_ls_hook_count].pc = pc & SPU_LS_MASK;
+        s_ls_hooks[s_ls_hook_count].fn = fn;
+        s_ls_hook_count++;
+    }
+}
+
+static int spu_ls_hook_dispatch(spu_context* ctx)
+{
+    uint32_t pc = ctx->pc & SPU_LS_MASK;
+    for (int i = 0; i < s_ls_hook_count; i++)
+        if (s_ls_hooks[i].pc == pc && s_ls_hooks[i].image_id == ctx->image_id)
+            return s_ls_hooks[i].fn(ctx);
+    return 0;
+}
