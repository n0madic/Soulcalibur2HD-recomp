 static int   s_eng_fxaa = -1;
 static float s_eng_sharpen = -1.0f;
 static id<MTLRenderPipelineState> s_eng_fxaa_pso;
+static id<MTLTexture>             s_loading_tex;      /* the boot "Loading..." text */
+static unsigned                   s_loading_scale;
 static MTLPixelFormat             s_eng_fxaa_pso_fmt;
 static id<MTLTexture>             s_eng_fxaa_tex;
 
@@ -2664,6 +2667,7 @@ static void eng_shutdown(void* user)
     s_eng_linear_sampler = nil;
     s_eng_fxaa_pso = nil;
     s_eng_fxaa_tex = nil;
+    s_loading_tex = nil;
     s_eng_active = 0;
     s_eng_encoding_failed = 0;
     s_eng_checked_completed = 0;
@@ -3590,6 +3594,36 @@ static void eng_encode_records(id<MTLCommandBuffer> cb, id<MTLBuffer> stage)
  * PS3_SHARPEN this pass sharpens it as it samples. Either one that is off or
  * fails is skipped. The picture keeps its aspect ratio: it is fitted into the drawable and
  * centred, and the rest is black (letterbox). */
+/* The boot "Loading..." text (rsx_loading_overlay.h), drawn over the bottom right corner of the display pass with
+ * the same full-screen blit, its viewport shrunk to the text. */
+static void eng_draw_loading(id<MTLRenderCommandEncoder> e, id<MTLTexture> dst)
+{
+    const unsigned dw = (unsigned)[dst width], dh = (unsigned)[dst height];
+    const unsigned scale = rsx_loading_overlay_scale(dh);
+    const unsigned w = rsx_loading_overlay_width(scale), h = rsx_loading_overlay_height(scale);
+    if (!s_loading_tex || s_loading_scale != scale) {
+        unsigned char* rgba = (unsigned char*)malloc((size_t)w * h * 4u);
+        if (!rgba) return;
+        rsx_loading_overlay_render(rgba, scale);
+        MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                                                       width:w height:h mipmapped:NO];
+        s_loading_tex = [s_dev newTextureWithDescriptor:td];
+        [s_loading_tex replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:rgba bytesPerRow:(NSUInteger)w * 4u];
+        s_loading_scale = scale;
+        free(rgba);
+    }
+    if (!s_loading_tex || !s_eng_blit_pso) return;   /* the present pipeline eng_blit_to_display has set up */
+    unsigned x, y;
+    rsx_loading_overlay_place(dw, dh, scale, &x, &y);
+    [e setViewport:(MTLViewport){(double)x, (double)y, (double)w, (double)h, 0.0, 1.0}];
+    [e setRenderPipelineState:s_eng_blit_pso];
+    [e setFragmentTexture:s_loading_tex atIndex:0];
+    [e setFragmentSamplerState:s_eng_point_sampler atIndex:0];
+    { const struct { float gamma, sharp, px[2]; } plain = { 1.0f, 0.0f, { 0.0f, 0.0f } };   /* no gamma, no sharpening */
+      [e setFragmentBytes:&plain length:sizeof plain atIndex:0]; }
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+}
+
 static void eng_blit_to_display(id<MTLCommandBuffer> cb, id<MTLTexture> src,
                                 id<MTLTexture> dst)
 {
@@ -3635,6 +3669,7 @@ static void eng_blit_to_display(id<MTLCommandBuffer> cb, id<MTLTexture> src,
           { 1.0f / (float)[src width], 1.0f / (float)[src height] } };
       [e setFragmentBytes:&p length:sizeof p atIndex:0]; }
     [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    if (rsx_draw_engine_loading_overlay()) eng_draw_loading(e, dst);
     [e endEncoding];
 }
 
