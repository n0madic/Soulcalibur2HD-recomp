-static void pad_init_backend(void)
-{
-    if (!s_sdl_inited) {
-        if (SDL_WasInit(SDL_INIT_GAMECONTROLLER) == 0) {
-            SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER);
+/* SDL's joystick layer is thread-affine on macOS: the IOKit/HIDAPI hotplug
+ * callbacks are scheduled on the run loop of the thread that initialised the
+ * subsystem, and only that thread's SDL_GameControllerUpdate delivers them.
+ * Initialising on whichever guest thread called cellPadInit and sweeping from
+ * whichever called cellPadGetData means a controller plugged in after start is
+ * never seen. So the subsystem lives on one dedicated thread, which does all
+ * the SDL work; guest threads only copy its latest snapshot. */
+#define PAD_SDL_SWEEP_MS 2
+
+static int SDLCALL pad_sdl_thread(void* unused)
+{
+    (void)unused;
+    int ok = SDL_WasInit(SDL_INIT_GAMECONTROLLER) != 0 ||
+             SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER) == 0;
+    if (!ok)
+        fprintf(stderr, "[cellPad] SDL gamecontroller init failed: %s\n", SDL_GetError());
+
+    while (!s_sdl_stop) {
+        if (ok) pad_sdl_sweep();
+        if (s_sdl_ready) {   /* the first sweep has opened the controllers present at start */
+            SDL_SemPost(s_sdl_ready);
+            s_sdl_ready = NULL;
         }
-        s_sdl_inited = 1;
+        SDL_Delay(PAD_SDL_SWEEP_MS);
     }
-    memset(s_sdl_controllers, 0, sizeof(s_sdl_controllers));
 
-    /* Open any controllers already connected */
-    int num = SDL_NumJoysticks();
-    for (int i = 0; i < num && i < PAD_MAX_HOST_PORTS; i++) {
-        if (SDL_IsGameController(i)) {
-            s_sdl_controllers[i] = SDL_GameControllerOpen(i);
-        }
-    }
-}
-
-static void pad_shutdown_backend(void)
-{
+    SDL_LockMutex(s_sdl_lock);
     for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) {
         if (s_sdl_controllers[i]) {
             SDL_GameControllerClose(s_sdl_controllers[i]);
             s_sdl_controllers[i] = NULL;
         }
     }
+    SDL_UnlockMutex(s_sdl_lock);
+    if (ok) SDL_QuitSubSystem(SDL_INIT_GAMECONTROLLER);
+    return 0;
+}
+
+/* Called from pad_poll_backend: hand the SDL thread's latest snapshot to the guest-facing state. */
+static void pad_poll_sdl2(void)
+{
+    SDL_LockMutex(s_sdl_lock);
+    for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) s_host_state[i] = s_sdl_state[i];
+    SDL_UnlockMutex(s_sdl_lock);
+}
+
+static void pad_init_backend(void)
+{
+    if (s_sdl_thread) return;
+    memset(s_sdl_controllers, 0, sizeof(s_sdl_controllers));
+    memset(s_sdl_state, 0, sizeof(s_sdl_state));
+    s_sdl_stop = 0;
+    s_sdl_lock = SDL_CreateMutex();
+    s_sdl_ready = SDL_CreateSemaphore(0);
+    SDL_sem* ready = s_sdl_ready;
+    s_sdl_thread = SDL_CreateThread(pad_sdl_thread, "ps3recomp-pad", NULL);
+    if (!s_sdl_thread) {
+        fprintf(stderr, "[cellPad] cannot start the SDL pad thread: %s\n", SDL_GetError());
+        s_sdl_ready = NULL;
+        SDL_DestroySemaphore(ready);
+        return;
+    }
+    SDL_SemWait(ready);   /* posted by the thread's first sweep even if SDL init failed */
+    SDL_DestroySemaphore(ready);
+}
+
+static void pad_shutdown_backend(void)
+{
+    if (!s_sdl_thread) return;
+    s_sdl_stop = 1;
+    SDL_WaitThread(s_sdl_thread, NULL);
+    s_sdl_thread = NULL;
+    SDL_DestroyMutex(s_sdl_lock);
+    s_sdl_lock = NULL;
+    memset(s_sdl_state, 0, sizeof(s_sdl_state));
 }
 
 #endif /* PAD_BACKEND_SDL2 */
