+/* cellSpursShutdownTaskset: the tasks created so far in `taskset_ea` are gone. Wake the parked
+ * ones; each sees its generation is stale and ends. */
+void spu_taskset_bump_generation(uint32_t taskset_ea)
+{
+    if (!taskset_ea) return;
+    int slot = -1;
+    for (int i = 0; i < TS_GEN_MAX; i++) if (s_tsgen[i].ea == taskset_ea) { slot = i; break; }
+    if (slot < 0) for (int i = 0; i < TS_GEN_MAX; i++) if (!s_tsgen[i].ea) { slot = i; s_tsgen[i].ea = taskset_ea; break; }
+    if (slot < 0) return;
+    s_tsgen[slot].gen++;
+#ifdef _WIN32
+    AcquireSRWLockExclusive(&s_sig_lock);
+    WakeAllConditionVariable(&s_sig_cv);
+    ReleaseSRWLockExclusive(&s_sig_lock);
+#else
+    pthread_mutex_lock(&s_sig_lock);
+    pthread_cond_broadcast(&s_sig_cv);
+    pthread_mutex_unlock(&s_sig_lock);
+#endif
+}
