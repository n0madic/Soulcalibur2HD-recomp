diff --git a/libs/system/cellGame.c b/libs/system/cellGame.c
index 071b9ec..48b09db 100644
--- a/libs/system/cellGame.c
+++ b/libs/system/cellGame.c
@@ -295,6 +295,14 @@ void cellGame_init_from_paramsfo(const char* sfo_path)
         printf("[cellGame] PARAM.SFO not read ('%s'); keeping title id '%s'\n",
                sfo_path, s_title_id);
     }
+    /* CATEGORY decides what cellGameBootCheck reports: "HG" is an HDD game (a PSN
+     * download, booted from /dev_hdd0/game/<id>), "DG" a disc game. Titles check
+     * the type -- Soulcalibur II HD aborts its boot unless it is HDD. */
+    if (sfo_read_string(sfo_path, "CATEGORY", tmp, sizeof(tmp)) == 0 && tmp[0]) {
+        if (strcmp(tmp, "HG") == 0)      s_game_type = CELL_GAME_GAMETYPE_HDD;
+        else if (strcmp(tmp, "DG") == 0) s_game_type = CELL_GAME_GAMETYPE_DISC;
+        printf("[cellGame] CATEGORY '%s' -> game type %u\n", tmp, s_game_type);
+    }
     if (sfo_read_string(sfo_path, "TITLE", tmp, sizeof(tmp)) == 0 && tmp[0]) {
         strncpy(s_title, tmp, sizeof(s_title) - 1); s_title[sizeof(s_title) - 1] = '\0';
     }
