  * surface at display size (w x h) while the guest laid it out k times wider and taller
  * (pitch = 4 * k * w, k * h rows, often split over several address ranges), so the k:1 downsample
@@ -774,6 +975,23 @@ int rsx_draw_engine_resolve_read(u32 src_loc, u32 src_offset, u32 src_pitch, u32
     u32 w = out_w, h = out_h;
     if (sx + w > s->w) w = s->w - sx;
     if (sy + h > s->h) h = s->h - sy;
+    /* Kept on the GPU: the destination is the host picture's own layout when its host pixel (0, 0) is at
+     * dst_offset - (sy rows + sx pixels), which holds for every tile of one resolve. */
