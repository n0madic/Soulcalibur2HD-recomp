+/* Engine draws are batched: a draw records into s_vk.cmd and leaves it open, and the batch is submitted and
+ * waited on only when something else needs the GPU or a resource a recorded draw uses (any vk_begin, a release, a
+ * framebuffer drop, the engine's submit_and_wait). One submission and fence wait per draw was what limited a
+ * fight to a few frames a second: the frame thread spent its time in the driver's fence wait. The data each
+ * draw reads (vertices, indices, constants, descriptor set) comes from per-batch arenas the flush resets.
+ * Consecutive draws into the same framebuffer share one render pass: a pass per draw loaded and stored the
+ * whole colour and depth target every time (hundreds of times a frame). Uploads, clears and depth snapshots are
+ * recorded into the batch too (vk_rec_begin); only a readback or a present waits for the GPU. */
+static struct { int open; VkFramebuffer pass_fb; VkRenderPass pass_rp; } s_batch;
+static void vk_eng_batch_reset(void);
+static void vk_destroy_image(vk_image* im);
+/* Images whose last use may still be in the open batch: destroyed by the flush, after its wait. */
+#define VK_DEFER_MAX 256
+static vk_image s_defer[VK_DEFER_MAX];
+static u32      s_defer_n;
+static void vk_batch_end_pass(void)
+{
+    if (!s_batch.pass_fb) return;
+    pvkCmdEndRenderPass(s_vk.cmd);
+    s_batch.pass_fb = VK_NULL_HANDLE;
+    s_batch.pass_rp = VK_NULL_HANDLE;
+}
+/* After the batch's submission has completed: its arenas are free again and the images it may have used can go. */
+static void vk_batch_retire(void)
+{
+    vk_eng_batch_reset();
+    for (u32 i = 0; i < s_defer_n; i++) vk_destroy_image(&s_defer[i]);
+    s_defer_n = 0;
+}
+static int vk_batch_flush(void)
+{
+    if (!s_batch.open) return 0;
+    vk_batch_end_pass();
+    s_batch.open = 0;
+    const int rc = vk_submit_and_wait();
+    vk_batch_retire();
+    return rc;
+}
+static int vk_begin(void)
+{
+    if (vk_batch_flush()) return -1;
+    return vk_cmd_begin();
+}
+/* Records into the batch outside any render pass, for work whose result only the GPU reads later (uploads,
+ * clears, layout set-up, depth snapshots): no submission and no wait. Ended by the next flush. */
+static int vk_batch_open(void)
+{
+    if (s_batch.open) return 0;
+    if (vk_cmd_begin()) return -1;
+    s_batch.open = 1;
+    return 0;
+}
+static int vk_rec_begin(void)
+{
+    if (vk_batch_open()) return -1;
+    vk_batch_end_pass();
+    return 0;
+}
+static void vk_defer_destroy_image(vk_image* im)
+{
+    if (!s_batch.open) { vk_destroy_image(im); return; }
+    if (s_defer_n >= VK_DEFER_MAX) { vk_batch_flush(); vk_destroy_image(im); return; }
+    s_defer[s_defer_n++] = *im;
+    memset(im, 0, sizeof *im);
+}
+
