+/* Cached textures that may cover [offset, offset + bytes) are re-hashed on their next use; a texture's span is not
+ * kept, so one starting up to 8 MB below counts. */
+static void eng_textures_rehash(u32 location, u32 offset, u32 bytes)
+{
+    for (u32 i = 0; i < g.n_textures; i++) {
+        eng_texture* e = &g.textures[i];
+        if (e->location != location) continue;
+        if (e->offset >= offset ? e->offset - offset < bytes : offset - e->offset < 0x800000u) {
+            e->last_hash_frame = g.frames - 1u;
+            e->last_full_frame = 0;   /* long ago: its next use takes the full hash, the sparse check may miss a tile */
