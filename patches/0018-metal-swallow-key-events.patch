@@ -3335,6 +3335,13 @@ static int pump_messages_impl(void)
                                                 inMode:NSDefaultRunLoopMode
                                                dequeue:YES];
             if (!ev) break;
+            /* The pad reads the keyboard by polling, so key events have no consumer here: the window would
+             * answer each with the system alert sound. Only Command shortcuts (Cmd+Q) reach the menu. */
+            if ([ev type] == NSEventTypeKeyDown || [ev type] == NSEventTypeKeyUp) {
+                if ([ev type] == NSEventTypeKeyDown && ([ev modifierFlags] & NSEventModifierFlagCommand))
+                    [[NSApp mainMenu] performKeyEquivalent:ev];
+                continue;
+            }
             [NSApp sendEvent:ev];
         }
