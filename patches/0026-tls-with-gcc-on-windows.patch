Thread-local storage: use __thread unless the compiler is MSVC.

GCC and MinGW ignore __declspec(thread) with only a warning ('thread' attribute directive ignored), so on a MinGW build
these variables were plain globals shared by every thread: the thread-exit jump buffer (a thread exiting jumped into
another thread's frame), the SPURS job answer slots and the sysutil completion flag. __thread is native TLS there.

---
diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -2536,7 +2536,7 @@ static int jg_wait(u32 ea)
  * this queue, and would only notify again after the event arrives -- so
  * signalling at walker exit deadlocks both sides. Signal when the WORK
  * completes: at END, and on reaching a guard with jobs run this lap. */
-#ifdef _WIN32
+#ifdef _MSC_VER
 #  define SPURS_JOB_TLS __declspec(thread)
 #else
 #  define SPURS_JOB_TLS __thread
diff --git a/libs/system/cellSysutil.c b/libs/system/cellSysutil.c
--- a/libs/system/cellSysutil.c
+++ b/libs/system/cellSysutil.c
@@ -81,8 +81,12 @@ void cellSysutilQueueEvent(int slot, uint32_t status, uint32_t param)
 static SRWLOCK s_completion_lock = SRWLOCK_INIT;
 #define COMPLETION_LOCK() AcquireSRWLockExclusive(&s_completion_lock)
 #define COMPLETION_UNLOCK() ReleaseSRWLockExclusive(&s_completion_lock)
+#ifdef _MSC_VER
 #define COMPLETION_TLS __declspec(thread)
 #else
+#define COMPLETION_TLS __thread
+#endif
+#else
 #include <pthread.h>
 static pthread_mutex_t s_completion_lock = PTHREAD_MUTEX_INITIALIZER;
 #define COMPLETION_LOCK() pthread_mutex_lock(&s_completion_lock)
diff --git a/runtime/spu/spurs_job.c b/runtime/spu/spurs_job.c
--- a/runtime/spu/spurs_job.c
+++ b/runtime/spu/spurs_job.c
@@ -135,7 +135,7 @@ const uint8_t* spurs_job_ls_for_handle(uint32_t handle)
  * flight. As plain globals these were clobbered between a job finishing and its
  * own completion being pushed, so a query could be answered with an unrelated
  * job's mailbox. Per-thread keeps each job paired with its own answer. */
-#ifdef _WIN32
+#ifdef _MSC_VER
 #  define SPURS_JOB_TLS __declspec(thread)
 #else
 #  define SPURS_JOB_TLS __thread
diff --git a/runtime/syscalls/sys_ppu_thread.c b/runtime/syscalls/sys_ppu_thread.c
--- a/runtime/syscalls/sys_ppu_thread.c
+++ b/runtime/syscalls/sys_ppu_thread.c
@@ -9,7 +9,7 @@
  * from inside a loop and so called exit 1,435 times in one run, staying alive
  * and holding whatever it held. Arm a jump in the thread proc and unwind to it
  * instead. PS3_NO_THREAD_EXIT_UNWIND=1 restores the old behaviour. */
-#if defined(_WIN32)
+#if defined(_MSC_VER)
 #  define PPU_TLS __declspec(thread)
 #else
 #  define PPU_TLS __thread
