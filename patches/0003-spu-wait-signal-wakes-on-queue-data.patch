+ * address leaves the old tasks' host threads parked in WAIT_SIGNAL: the HLE has no way to stop
+ * them, and they would answer signals meant for the new taskset and, when they finally exit,
+ * clear the new taskset's task bits. cellSpursShutdownTaskset bumps the generation of its
+ * address; a task remembers the generation it was created in and ends itself once it differs. */
+#define TS_GEN_MAX 32
+static struct { volatile uint32_t ea; volatile uint32_t gen; } s_tsgen[TS_GEN_MAX];
