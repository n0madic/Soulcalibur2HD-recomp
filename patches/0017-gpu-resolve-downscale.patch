+                                    u32 sx, u32 sy, u32 w, u32 h, u32 k)
+{
+    (void)user;
+    id<MTLTexture> d = eng_obj(dst);
+    id<MTLTexture> t = eng_obj(src);
+    if (!d || !t || dst == src || !s_eng_helper_lib || !w || !h || k < 2u || k > 4u ||
+        [d pixelFormat] != MTLPixelFormatRGBA8Unorm || [t pixelFormat] != MTLPixelFormatRGBA8Unorm ||
+        [d textureType] != MTLTextureType2D || [t textureType] != MTLTextureType2D ||
+        [d sampleCount] != 1 || [t sampleCount] != 1 ||
+        dx + w > [d width] || dy + h > [d height] || s_eng_rec_count >= ENG_MAX_RECORDS)
+        return -1;
