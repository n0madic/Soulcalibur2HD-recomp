+ * and leaves ctx->pc at the return address, like the real function's `bi $r0`. */
+#define SPU_LS_HOOK_MAX 16
+static struct { int image_id; uint32_t pc; spu_ls_hook_fn fn; } s_ls_hooks[SPU_LS_HOOK_MAX];
+static int s_ls_hook_count;
+
+void spu_register_ls_hook(int image_id, uint32_t pc, spu_ls_hook_fn fn)
+{
+    if (s_ls_hook_count < SPU_LS_HOOK_MAX) {
+        s_ls_hooks[s_ls_hook_count].image_id = image_id;
+        s_ls_hooks[s_ls_hook_count].pc = pc & SPU_LS_MASK;
+        s_ls_hooks[s_ls_hook_count].fn = fn;
+        s_ls_hook_count++;
+    }
