Esc pauses: on the keyboard Esc is START (the game's pause menu), not quit.

- cellPad's keyboard fallback maps Esc to START next to Return, on Windows, macOS and SDL.
- The Vulkan, D3D12 and null windows no longer close on Esc. The game is left with the window's close button
  (Alt+F4; Cmd+Q on macOS, whose window never quit on Esc).

---
diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index 947b7b7..736a8f1 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -150,6 +150,7 @@ static int pad_key_down(int key) { return (GetAsyncKeyState(key) & 0x8000) != 0;
 #define PADKEY_2 '2'
 #define PADKEY_RETURN VK_RETURN
 #define PADKEY_TAB VK_TAB
+#define PADKEY_ESCAPE VK_ESCAPE
 #elif defined(__APPLE__)
 /* macOS: virtual key codes (Carbon HIToolbox/Events.h kVK_*), polled with CGEventSourceKeyState,
  * which needs no event tap and no window. "Focused" is NSApplication.isActive of this process,
@@ -186,6 +187,7 @@ static int pad_key_down(int key)
 #define PADKEY_2 19
 #define PADKEY_RETURN 36
 #define PADKEY_TAB 48
+#define PADKEY_ESCAPE 53
 #elif PAD_BACKEND_SDL2
 /* Everywhere else the keyboard is SDL's: scancodes are physical keys, like the macOS codes above. The state is kept
  * current by whoever pumps SDL's events (the window of the RSX backend); without a video subsystem nothing is ever
@@ -212,6 +214,7 @@ static int pad_key_down(int key)
 #define PADKEY_2 SDL_SCANCODE_2
 #define PADKEY_RETURN SDL_SCANCODE_RETURN
 #define PADKEY_TAB SDL_SCANCODE_TAB
+#define PADKEY_ESCAPE SDL_SCANCODE_ESCAPE
 #endif
 
 #if defined(_WIN32) || defined(__APPLE__) || PAD_BACKEND_SDL2
@@ -241,6 +244,7 @@ static void pad_poll_keyboard(void)
         { PADKEY_Q,      CELL_PAD_CTRL_L1 },      { PADKEY_W,     CELL_PAD_CTRL_R1 },
         { PADKEY_1,      CELL_PAD_CTRL_L2 },      { PADKEY_2,     CELL_PAD_CTRL_R2 },
         { PADKEY_RETURN, CELL_PAD_CTRL_START },   { PADKEY_TAB,   CELL_PAD_CTRL_SELECT },
+        { PADKEY_ESCAPE, CELL_PAD_CTRL_START },   /* Esc pauses, as in PC games */
     };
 
     u16 btns = 0;
diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 02c6c6f..95c2862 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -503,11 +503,7 @@ static LRESULT CALLBACK d3d12_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
         PostQuitMessage(0);
         return 0;
     case WM_KEYDOWN:
-        if (wp == VK_ESCAPE) {
-            s_d3d.window_closed = 1;
-            DestroyWindow(hwnd);
-        }
-        return 0;
+        return 0;    /* Esc is the pad's START (cellPad), not a way out: the window's close button is */
     }
     return DefWindowProcA(hwnd, msg, wp, lp);
 }
diff --git a/libs/video/rsx_null_backend.c b/libs/video/rsx_null_backend.c
index 355cf09..c57f009 100644
--- a/libs/video/rsx_null_backend.c
+++ b/libs/video/rsx_null_backend.c
@@ -93,11 +93,7 @@ static LRESULT CALLBACK null_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
     }
 
     case WM_KEYDOWN:
-        if (wp == VK_ESCAPE) {
-            s_state.window_closed = 1;
-            DestroyWindow(hwnd);
-        }
-        return 0;
+        return 0;    /* Esc is the pad's START (cellPad), not a way out: the window's close button is */
     }
 
     return DefWindowProcA(hwnd, msg, wp, lp);
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index adc3fae..55123f7 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -3784,7 +3784,6 @@ int rsx_vulkan_backend_pump_messages(void)
     SDL_Event e;
     while (SDL_PollEvent(&e)) {
         if (e.type == SDL_QUIT) quit = 1;
-        else if (e.type == SDL_KEYDOWN && e.key.keysym.sym == SDLK_ESCAPE) quit = 1;
         else if (e.type == SDL_KEYDOWN && !e.key.repeat && s_vk.window &&
                  (e.key.keysym.sym == SDLK_F11 ||
                   (e.key.keysym.sym == SDLK_RETURN && (e.key.keysym.mod & KMOD_ALT)))) {
