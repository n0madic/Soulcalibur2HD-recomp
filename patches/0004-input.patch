+/* Called from pad_poll_backend: hand the SDL thread's latest snapshot to the guest-facing state. */
+static void pad_poll_sdl2(void)
+{
+    SDL_LockMutex(s_sdl_lock);
+    for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) s_host_state[i] = s_sdl_state[i];
+    SDL_UnlockMutex(s_sdl_lock);
+}
+
+static void pad_init_backend(void)
+{
+    if (s_sdl_thread) return;
+    memset(s_sdl_controllers, 0, sizeof(s_sdl_controllers));
+    memset(s_sdl_state, 0, sizeof(s_sdl_state));
+    memset(s_rumble, 0, sizeof s_rumble);
+    s_sdl_stop = 0;
+    s_sdl_lock = SDL_CreateMutex();
+    s_sdl_ready = SDL_CreateSemaphore(0);
+    SDL_sem* ready = s_sdl_ready;
+    s_sdl_thread = SDL_CreateThread(pad_sdl_thread, "ps3recomp-pad", NULL);
+    if (!s_sdl_thread) {
+        fprintf(stderr, "[cellPad] cannot start the SDL pad thread: %s\n", SDL_GetError());
+        s_sdl_ready = NULL;
+        SDL_DestroySemaphore(ready);
+        return;
+    }
+    SDL_SemWait(ready);   /* posted by the thread's first sweep even if SDL init failed */
+    SDL_DestroySemaphore(ready);
+}
+
+static void pad_shutdown_backend(void)
+{
+    if (!s_sdl_thread) return;
+    s_sdl_stop = 1;
+    SDL_WaitThread(s_sdl_thread, NULL);
+    s_sdl_thread = NULL;
+    SDL_DestroyMutex(s_sdl_lock);
+    s_sdl_lock = NULL;
+    memset(s_sdl_state, 0, sizeof(s_sdl_state));
