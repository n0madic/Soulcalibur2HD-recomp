+/* AutoLoad reports a first-boot "no save data" as CELL_OK by default (flOw parks in its
+ * auto-load state on the SDK's CELL_SAVEDATA_ERROR_NODATA). PS3_SAVEDATA_NODATA_OK picks what a
+ * title that branches on the result gets instead: 0 = ERROR_NODATA, 2 = ERROR_CBRESULT (what the
+ * hardware returns when the stat callback answers ERR_NODATA). Soulcalibur II HD otherwise
+ * decodes its all-zero buffer as a loaded options block (brightness step 0, a tenth of the
+ * picture). */
+static s32 savedata_autoload_result(s32 r)
+{
+    if (r != CELL_SAVEDATA_ERROR_NODATA) return r;
+    const char* e = getenv("PS3_SAVEDATA_NODATA_OK");
+    if (e && atoi(e) == 2) return CELL_SAVEDATA_ERROR_CBRESULT;
+    return (e && atoi(e) == 0) ? r : CELL_OK;
+}
