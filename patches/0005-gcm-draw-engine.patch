+static int eng_gpu_resolve_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_ENGINE_GPU_RESOLVE"); on = !(e && e[0] == '0'); }
+    return on && g.be->color_target_copy && g.be->readback;
