cellAudio (Windows): mix on the block clock instead of a minimum gap after the last mix.

patches/0027 kept 4 ms between two mixed blocks so the guest's audio thread, woken by the notify after each block, has
time to write the next. Sleep(1) wakes a millisecond or more late, so on a busy machine the guest often had less than
that: in a Soulcalibur II HD fight on a 4+4-core laptop 5-10% of the blocks came out silent (crackle). A 5 ms gap
fixed the gaps but fell behind real time (165 blocks a second). The mix is now paced on an ideal 5.33 ms clock, waited
on with a high-resolution waitable timer: the guest gets the whole block period for every block, the rate is exactly
187.5 blocks a second, and catching up after a stall still keeps two blocks at least 4 ms apart.

---
diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index 05fca3f..66111f9 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -552,15 +552,40 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
     /* A device that reports room in coarse steps (WASAPI wakes the loop once per engine period, 10 ms or more) frees
      * room for two blocks at a time. Mixing both at once leaves the guest no time for the second: the game's audio
      * thread is woken by the notify below and needs a few ms to write the next block, so every other block was mixed
-     * before it arrived and came out silent -- a 50% crackle. Keep a minimum gap between two blocks. */
-    const long long min_gap = qf.QuadPart * 4 / 1000;   /* 4 ms; a block is 5.33 ms */
-    long long last_mix = 0;
+     * before it arrived and came out silent -- a 50% crackle.
+     * So the blocks are spaced on an ideal 5.33 ms clock, which gives the guest the whole block period for each next
+     * block. A fixed minimum gap after the previous mix did not: Sleep(1) wakes a millisecond or more late, so a 4 ms
+     * gap left the guest too little time on a busy machine (5-10% of the blocks silent in a Soulcalibur II HD fight
+     * on a 4+4-core laptop) and a 5 ms one fell behind real time (165 blocks a second). The wait is a
+     * high-resolution waitable timer where Windows has one (10 1803+). */
+    const long long period  = qf.QuadPart * CELL_AUDIO_BLOCK_SAMPLES / CELL_AUDIO_SAMPLE_RATE;
+    const long long min_gap = period * 3 / 4;   /* catching up: never two blocks closer than 4 ms */
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+    HANDLE pace_timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                               TIMER_ALL_ACCESS);
+    long long next_due = 0, last_mix = 0;
     while (s_mix_thread_running) {
         const int room = audio_backend_room();
         if (room >= 0 && room < CELL_AUDIO_BLOCK_SAMPLES) { audio_backend_wait(); continue; }
         if (room >= 0) {
             LARGE_INTEGER now; QueryPerformanceCounter(&now);
-            if (now.QuadPart - last_mix < min_gap) { Sleep(1); continue; }
+            const long long due = next_due > last_mix + min_gap ? next_due : last_mix + min_gap;
+            if (now.QuadPart < due) {
+                if (pace_timer) {
+                    LARGE_INTEGER rel;
+                    rel.QuadPart = -(long long)((due - now.QuadPart) * 10000000 / qf.QuadPart);
+                    if (rel.QuadPart >= 0) rel.QuadPart = -1;
+                    SetWaitableTimer(pace_timer, &rel, 0, NULL, NULL, FALSE);
+                    WaitForSingleObject(pace_timer, 20);
+                } else {
+                    Sleep(1);
+                }
+                continue;
+            }
+            /* More than two blocks behind (a stall): restart the clock rather than mix a burst. */
+            next_due = (now.QuadPart - next_due > 2 * period) ? now.QuadPart + period : next_due + period;
             last_mix = now.QuadPart;
         }
         if (room < 0) {
@@ -611,6 +636,7 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
         audio_notify_event_queues();
     }
 
+    if (pace_timer) CloseHandle(pace_timer);
     printf("[cellAudio] Mixing thread stopped\n");
     return 0;
 }
