NV3089: copy an unscaled 32-bit blit row by row.

Soulcalibur II HD copies its 1280x720 front buffer to main memory every frame. The per-pixel loop made a guest read
and a guest write accessor call per pixel. At 1:1 the two byte swaps cancel, so each row is a block store of the
source bytes (vm_memcpy_to, which breaks SPU reservations per line as vm_write32 would). Overlapping ranges, a PPU
reservation or an armed write watch keep the per-pixel loop.

---
diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index 8b91369..7a3afb4 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -1146,7 +1146,30 @@ static void nv3089_blit(void)
             return;
     }
     if (bpp == 4) nv3089_engine_read(in_pitch, out_w, out_h);
-    for (u32 y = 0; y < out_h; y++) {
+    /* An unscaled copy is a row copy: a 1280x720 one per frame (this title copies its front buffer out each frame)
+     * cost a read and a write accessor call per pixel. The two byte swaps of the per-pixel path cancel, so a row is
+     * a block store of the source bytes; vm_memcpy_to breaks SPU reservations per line as vm_write32 would. Overlap,
+     * a PPU reservation or a write watch keep the per-pixel path. */
+    int rows_done = 0;
+    if (s_nv3089.ds_dx == 0x100000u && s_nv3089.dt_dy == 0x100000u && g_resv_store_active <= 0 && !g_ww_hi) {
+        const u32 x0 = out_x > cx0 ? out_x : cx0, y0 = out_y > cy0 ? out_y : cy0;
+        const u32 x1 = (out_x + out_w < cx1) ? out_x + out_w : cx1;
+        const u32 y1 = (out_y + out_h < cy1) ? out_y + out_h : cy1;
+        /* The per-pixel loop's source position at 1:1: ((u0 << 8) + x * 1.0) >> 20. */
+        const u32 sx = (u0 >> 12) + (x0 - out_x), sy0 = (v0 >> 12) + (y0 - out_y);
+        const u64 s_lo = (u64)src + (u64)sy0 * in_pitch + (u64)sx * bpp;
+        const u64 s_hi = s_lo + (u64)(y1 > y0 ? y1 - y0 : 0) * in_pitch;
+        const u64 d_lo = (u64)dst + (u64)y0 * dst_pitch + (u64)x0 * bpp;
+        const u64 d_hi = d_lo + (u64)(y1 > y0 ? y1 - y0 : 0) * dst_pitch;
+        if (x1 > x0 && y1 > y0 && (s_hi <= d_lo || d_hi <= s_lo) && s_hi < 0x100000000ull && d_hi < 0x100000000ull) {
+            const u32 len = (x1 - x0) * bpp;
+            for (u32 y = y0; y < y1; y++)
+                vm_memcpy_to((u32)(d_lo + (u64)(y - y0) * dst_pitch),
+                             vm_ptr8((u32)(s_lo + (u64)(y - y0) * in_pitch)), len);
+            rows_done = 1;
+        }
+    }
+    for (u32 y = 0; !rows_done && y < out_h; y++) {
         u32 dy = out_y + y;
         if (dy < cy0 || dy >= cy1) continue;
         u64 sv = ((u64)v0 << 8) + (u64)y * s_nv3089.dt_dy;         /* 20.12 */
