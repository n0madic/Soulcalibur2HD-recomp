+    volatile int blocked;      /* the thread has reached a blocking call (ppu_thread_note_block) */
 
 #ifdef _WIN32
     HANDLE       host_thread;
@@ -89,6 +90,10 @@ int64_t sys_ppu_thread_create(ppu_context* ctx);
  * Call before the first sys_ppu_thread_create so no created thread aliases
  * main (thread_id 0 broke every owner-tracking sync primitive). */
 uint64_t ppu_thread_register_main(void);
+
+/* Called by the blocking syscalls (event queue receive, sleeps): thread `tid` has reached a point where lv2 would
+ * schedule another thread. sys_ppu_thread_create waits for it on a higher-priority thread it has just created. */
+void ppu_thread_note_block(uint64_t tid);
