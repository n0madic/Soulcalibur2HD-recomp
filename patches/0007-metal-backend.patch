+/* Opt-in readback of the game surface, useful on a locked Mac or in CI. */
+static void eng_dump_frame(id<MTLTexture> src)
+{
+    const char* path = getenv("PS3RECOMP_METAL_FRAME_DUMP");
+    if (!path || !*path) return;
+    static unsigned frame;
+    if ((++frame % 120) != 0) return;
+    eng_write_ppm(src, path);
+}
+
+/* PS3RECOMP_METAL_PRESENT_DUMP=<dir> (headless only, the drawable cannot be read): every 120th
+ * presented frame as it leaves the display pass, FXAA included, to <dir>/present_<n>.ppm; with FXAA
+ * on (PS3_AA=fxaa), the unfiltered surface goes next to it as present_<n>_raw.ppm. */
+static void eng_dump_presented(id<MTLTexture> dst, id<MTLTexture> raw)
+{
+    const char* dir = getenv("PS3RECOMP_METAL_PRESENT_DUMP");
+    if (!dir || !*dir || !s_headless || !dst) return;
+    static unsigned frame;
+    if ((++frame % 120) != 0) return;
+    char path[1024];
+    snprintf(path, sizeof path, "%s/present_%05u.ppm", dir, frame);
+    eng_write_ppm(dst, path);
+    if (s_eng_fxaa > 0) {
+        snprintf(path, sizeof path, "%s/present_%05u_raw.ppm", dir, frame);
+        eng_write_ppm(raw, path);
+    }
+}
