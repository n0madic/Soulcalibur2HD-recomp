+/* One rectangle of `o` to one of `d` through a linear blit: a texel block downscaled to the pixel(s) it covers. */
+static void vk_eng_blit_rect(vk_eng_obj* o, vk_eng_obj* d, u32 x0, u32 y0, u32 x1, u32 y1,
+                             u32 dx0, u32 dy0, u32 dx1, u32 dy1)
+{
+    VkImageBlit blit = {
+        .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .srcOffsets = { { (int32_t)x0, (int32_t)y0, 0 }, { (int32_t)x1, (int32_t)y1, 1 } },
+        .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .dstOffsets = { { (int32_t)dx0, (int32_t)dy0, 0 }, { (int32_t)dx1, (int32_t)dy1, 1 } },
+    };
+    pvkCmdBlitImage(s_vk.cmd, o->im.img, VK_IMAGE_LAYOUT_GENERAL, d->im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &blit,
+                    VK_FILTER_LINEAR);
+}
+
+/* A 1/k downscale of a rectangle of one colour target into another, recorded into the batch: each destination
+ * pixel is the linear sample at the centre of its k x k block of the source (a box average for k = 2). A linear
+ * blit does exactly that for the blocks that lie inside the source, as one command; a block that reaches past the
+ * edge (the +1 texel source origin of a resolve tile shifts the last block of the picture out of it) is
+ * a blit of the texels that remain, which is the same as the edge repeating. */
+static int vk_eng_color_target_resolve(void* user, u32 dst, u32 dx, u32 dy, u32 src,
+                                       u32 sx, u32 sy, u32 w, u32 h, u32 k)
+{
+    (void)user;
+    vk_eng_obj* d = vk_eng_get(dst, VK_ENG_COLOR);
+    vk_eng_obj* o = vk_eng_get(src, VK_ENG_COLOR);
+    if (!d || !o || dst == src || d->fmt != VK_FORMAT_R8G8B8A8_UNORM || o->fmt != d->fmt || !w || !h ||
+        k < 2u || k > 4u || sx >= o->w || sy >= o->h || dx + w > d->w || dy + h > d->h)
+        return -1;
+    const u32 nx = (o->w - sx) / k < w ? (o->w - sx) / k : w;
+    const u32 ny = (o->h - sy) / k < h ? (o->h - sy) / k : h;
+    if ((w - nx) + (h - ny) > 8u || vk_rec_begin()) return -1;      /* mostly outside: the CPU copy does it */
+    vk_barrier_image(o->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    vk_barrier_image(d->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    if (nx && ny)
+        vk_eng_blit_rect(o, d, sx, sy, sx + nx * k, sy + ny * k, dx, dy, dx + nx, dy + ny);
+    for (u32 c = nx; c < w; c++) {                                    /* columns whose block crosses the edge */
+        const u32 x0 = sx + c * k < o->w ? sx + c * k : o->w - 1u;
+        const u32 x1 = sx + (c + 1u) * k < o->w ? sx + (c + 1u) * k : o->w;
+        if (ny) vk_eng_blit_rect(o, d, x0, sy, x1, sy + ny * k, dx + c, dy, dx + c + 1u, dy + ny);
+    }
+    for (u32 r = ny; r < h; r++) {                                    /* rows, and the corner pixels */
+        const u32 y0 = sy + r * k < o->h ? sy + r * k : o->h - 1u;
+        const u32 y1 = sy + (r + 1u) * k < o->h ? sy + (r + 1u) * k : o->h;
+        if (nx) vk_eng_blit_rect(o, d, sx, y0, sx + nx * k, y1, dx, dy + r, dx + nx, dy + r + 1u);
+        for (u32 c = nx; c < w; c++) {
+            const u32 x0 = sx + c * k < o->w ? sx + c * k : o->w - 1u;
+            const u32 x1 = sx + (c + 1u) * k < o->w ? sx + (c + 1u) * k : o->w;
+            vk_eng_blit_rect(o, d, x0, y0, x1, y1, dx + c, dy + r, dx + c + 1u, dy + r + 1u);
+        }
+    }
+    return 0;
+}
