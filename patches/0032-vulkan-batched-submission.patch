+/* Per-batch arenas (see s_batch): vertices, indices and constants of the recorded draws, and their descriptor
+ * sets. Grown, after a flush, when one draw needs more than an arena holds. */
+#define VK_EB_SETS 1024
+static struct {
+    vk_buffer        verts, idx, ubo, stage, zbuf;
+    VkDeviceSize     vpos, ipos, upos, spos, ubo_align;
+    VkDescriptorPool pool, split_pool;
+    u32              nsets, nsplit;
+    u8*              vsc;               /* the bound constants, copied into the arena by the draw */
+    u8*              psc;
+} s_eb;
+
+static void vk_eng_batch_reset(void)
+{
+    s_eb.vpos = s_eb.ipos = s_eb.upos = s_eb.spos = 0;
+    if (s_eb.nsets && s_eb.pool) pvkResetDescriptorPool(s_vk.device, s_eb.pool, 0);
+    if (s_eb.nsplit && s_eb.split_pool) pvkResetDescriptorPool(s_vk.device, s_eb.split_pool, 0);
+    s_eb.nsets = s_eb.nsplit = 0;
+}
+
+static VkDescriptorPool vk_eb_make_pool(void)
+{
+    VkDescriptorPoolSize ps[3] = {
+        { VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 2u * VK_EB_SETS },
+        { VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, RSX_MAX_TEXTURES * VK_EB_SETS },
+        { VK_DESCRIPTOR_TYPE_SAMPLER, RSX_MAX_TEXTURES * VK_EB_SETS },
+    };
+    VkDescriptorPoolCreateInfo pci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                                       .maxSets = VK_EB_SETS, .poolSizeCount = 3, .pPoolSizes = ps };
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    if (pvkCreateDescriptorPool(s_vk.device, &pci, NULL, &pool) != VK_SUCCESS) return VK_NULL_HANDLE;
+    return pool;
+}
+
+static VkDeviceSize vk_eb_align(VkDeviceSize v, VkDeviceSize a) { return (v + a - 1u) / a * a; }
+
+static int vk_eb_fits(const vk_buffer* b, VkDeviceSize pos, VkDeviceSize bytes, VkDeviceSize align)
+{
+    return b->buf && vk_eb_align(pos, align) + bytes <= b->size;
+}
+/* Only called with the batch flushed: the old buffer may go. */
+static int vk_eb_grow(vk_buffer* b, VkDeviceSize bytes, VkDeviceSize floor, VkBufferUsageFlags usage)
+{
+    if (b->buf && b->size >= bytes) return 0;
+    VkDeviceSize size = b->size ? b->size : floor;
+    while (size < bytes) size *= 2;
+    vk_destroy_buffer(b);
+    if (vk_create_host_buffer(b, size, usage)) return -1;
+    return b->coherent ? 0 : -1;
+}
+static VkDeviceSize vk_eb_take(const vk_buffer* b, VkDeviceSize* pos, const void* src, VkDeviceSize bytes,
+                               VkDeviceSize align)
+{
+    const VkDeviceSize off = vk_eb_align(*pos, align);
+    if (src && bytes) memcpy((u8*)b->ptr + off, src, (size_t)bytes);
+    *pos = off + bytes;
+    return off;
+}
+
+/* Makes room for one draw in the current batch, flushing it first when an arena or the set pool is full. */
+static int vk_eb_reserve(VkDeviceSize vbytes, VkDeviceSize ibytes, VkDeviceSize ubytes, int split)
+{
+    const VkDescriptorPool* pool = split ? &s_eb.split_pool : &s_eb.pool;
+    const u32 used = split ? s_eb.nsplit : s_eb.nsets;
+    if (!vk_eb_fits(&s_eb.verts, s_eb.vpos, vbytes, 16) ||
+        (ibytes && !vk_eb_fits(&s_eb.idx, s_eb.ipos, ibytes, 4)) ||
+        !vk_eb_fits(&s_eb.ubo, s_eb.upos, ubytes, s_eb.ubo_align) || !*pool || used >= VK_EB_SETS) {
+        if (vk_batch_flush()) return -1;
+        if (vk_eb_grow(&s_eb.verts, vbytes, 32u << 20, VK_BUFFER_USAGE_VERTEX_BUFFER_BIT) ||
+            vk_eb_grow(&s_eb.idx, ibytes ? ibytes : 4u, 8u << 20, VK_BUFFER_USAGE_INDEX_BUFFER_BIT) ||
+            vk_eb_grow(&s_eb.ubo, ubytes, 16u << 20, VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT))
+            return -1;
+        if (!*pool) {
+            const VkDescriptorPool np = vk_eb_make_pool();
+            if (!np) return -1;
+            if (split) s_eb.split_pool = np; else s_eb.pool = np;
+        }
+    }
+    return 0;
+}
+
+static void vk_eb_shutdown(void)
+{
+    vk_batch_flush();
+    vk_destroy_buffer(&s_eb.verts);
+    vk_destroy_buffer(&s_eb.idx);
+    vk_destroy_buffer(&s_eb.ubo);
+    vk_destroy_buffer(&s_eb.stage);
+    vk_destroy_buffer(&s_eb.zbuf);
+    if (s_eb.pool)       pvkDestroyDescriptorPool(s_vk.device, s_eb.pool, NULL);
+    if (s_eb.split_pool) pvkDestroyDescriptorPool(s_vk.device, s_eb.split_pool, NULL);
+    free(s_eb.vsc);
+    free(s_eb.psc);
+    memset(&s_eb, 0, sizeof s_eb);
+}
