+    memset(r, 0, sizeof *r);
+    r->kind = ENG_REC_COLOR_RESOLVE;
+    r->rt[0] = src;
+    r->resolve_dst = dst;
+    r->sc[0] = dx; r->sc[1] = dy; r->sc[2] = w; r->sc[3] = h;
+    r->rs_sx = sx; r->rs_sy = sy; r->rs_k = k;
+    return 0;
+}
