+    const u32 sy1 = (u32)((((u64)v0 << 8) + (u64)(out_h - 1) * s_nv3089.dt_dy) >> 20);
+    rsx_draw_engine_guest_access((s_nv3089.src_dma != 0xFEED0001u) ? RSX_LOCATION_LOCAL : RSX_LOCATION_MAIN,
+                                 s_nv3089.in_off, (sy1 + 1u) * in_pitch);
+    if (y1 > y0)
