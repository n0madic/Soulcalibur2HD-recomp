+/* A task parks in WAIT_SIGNAL with a lock-free queue as its wait object (LS[0x2FDC], the
+ * queue address with flag bits) when it popped an empty queue. On real SPURS the queue
+ * line records the parked task (waiting-list slots in push2/hs1) and the producer signals
+ * exactly that (workload, task). The HLE kernel keeps no such list, so a push signalled
+ * whichever task the line's zeroed slot named (workload 0, task 0): every other queue
+ * consumer slept forever. Wake on the queue state instead, which is what the signal means:
+ * an ANY2ANY CellSyncLFQueue (direction 3, initialised) holds data when the completed push
+ * pointer (u16 @+0x08) differs from the pop pointer (u16 @+0x00). */
+static int spu_wait_obj_queue_ready(uint32_t obj)
+{
+    extern uint8_t* vm_base;
+    if (!obj || (obj & 0x7Fu)) return 0;                       /* a queue line is 128-aligned */
+    uint32_t dir = ((uint32_t)vm_base[obj+0x24] << 24) | ((uint32_t)vm_base[obj+0x25] << 16) |
+                   ((uint32_t)vm_base[obj+0x26] << 8)  |  (uint32_t)vm_base[obj+0x27];
+    uint32_t init = ((uint32_t)vm_base[obj+0x2C] << 24) | ((uint32_t)vm_base[obj+0x2D] << 16) |
+                    ((uint32_t)vm_base[obj+0x2E] << 8)  |  (uint32_t)vm_base[obj+0x2F];
+    if (dir != 3 || init != 2) return 0;
+    uint16_t popped = (uint16_t)((vm_base[obj+0x00] << 8) | vm_base[obj+0x01]);
+    uint16_t pushed = (uint16_t)((vm_base[obj+0x08] << 8) | vm_base[obj+0x09]);
+    return popped != pushed;
+}
+
+static uint32_t spu_parked_wait_obj(uint32_t taskset_ea, uint32_t taskId)
+{
+    uint64_t key = ((uint64_t)taskset_ea << 32) | (uint64_t)(taskId + 1);
+    if (s_tls_parked_slot >= 0 && s_parked[s_tls_parked_slot] == key) return s_parked_obj[s_tls_parked_slot];
+    for (int i = 0; i < SPU_PARKED_MAX; i++)
+        if (s_parked[i] == key) return s_parked_obj[i];
+    return 0;
+}
