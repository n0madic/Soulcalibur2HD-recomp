diff --git a/runtime/syscalls/sys_ppu_thread.c b/runtime/syscalls/sys_ppu_thread.c
index a9ba1a3..ff40f2f 100644
--- a/runtime/syscalls/sys_ppu_thread.c
+++ b/runtime/syscalls/sys_ppu_thread.c
@@ -91,6 +91,38 @@ static ppu_thread_info* find_thread(uint64_t thread_id)
     return t;
 }
 
+/* ---------------------------------------------------------------------------
+ * Priority at thread start
+ *
+ * On lv2 a thread created with a higher priority (a lower number) than its creator preempts the creator and runs
+ * until it blocks. Game libraries rely on it: the SurMixer thread (prio 400, created by a prio 1000 thread) creates
+ * the event queue the creator then reads the key of, with no synchronisation of its own. Host threads run side by
+ * side, so the creator races ahead, reads a zero key, and the mixer is never notified (a movie without sound).
+ * sys_ppu_thread_create therefore waits for the new thread's first blocking call, with a bound so that a thread
+ * that blocks somewhere not reported here cannot hold the creator up for long. PS3_NO_PRIO_START=1 turns it off.
+ * -----------------------------------------------------------------------*/
+#define PPU_DEFAULT_PRIORITY   1000     /* what sys_ppu_thread_get_priority reports for the main thread */
+#define PRIO_START_TIMEOUT_MS  200
+
+void ppu_thread_note_block(uint64_t tid)
+{
+    if (tid >= 1 && tid <= PPU_THREAD_MAX) g_ppu_threads[tid - 1].blocked = 1;
+}
+
+static void wait_first_block(const ppu_thread_info* t)
+{
+    for (int i = 0; i < PRIO_START_TIMEOUT_MS * 10; i++) {
+        if (t->blocked || t->state == PPU_THREAD_STATE_FINISHED || t->state == PPU_THREAD_STATE_FREE) return;
+#ifdef _WIN32
+        Sleep(1);
+#else
+        usleep(100);
+#endif
+    }
+    fprintf(stderr, "[SYS] tid=%llu \"%s\" (prio %d) did not block within %d ms; its creator goes on\n",
+            (unsigned long long)t->ctx.thread_id, t->name, t->priority, PRIO_START_TIMEOUT_MS);
+}
+
 /* ---------------------------------------------------------------------------
  * Host thread entry point
  * -----------------------------------------------------------------------*/
@@ -495,7 +527,15 @@ int64_t sys_ppu_thread_create(ppu_context* ctx)
     }
 #endif
 
+    /* The creator is main (registered with priority 0, i.e. unset) or a created thread. */
+    const ppu_thread_info* creator = find_thread(ctx->thread_id);
+    const int32_t creator_prio = (creator && creator != &g_ppu_threads[0]) ? creator->priority : PPU_DEFAULT_PRIORITY;
+    static int s_prio_start = -1;
+    if (s_prio_start < 0) s_prio_start = getenv("PS3_NO_PRIO_START") ? 0 : 1;
+    const int preempts = s_prio_start && priority < creator_prio;
+
     table_unlock();
+    if (preempts) wait_first_block(t);
     return CELL_OK;
 }
 
