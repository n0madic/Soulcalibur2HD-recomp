cellAudio: diagnostics, and a mix paced on the block clock on Windows.

- AUDIO_PEAK=1 and AUDIO_WAV=<file> (a WAV dump of the mix).
- The mixer's two pacing clocks (the device's and the no-device one on the performance counter) are one: with no
  device the same block clock runs, waited on the same way.
- Windows: the mix is paced on an ideal 5.33 ms block clock, waited on with a high-resolution waitable timer, so the
  guest's audio thread gets the whole block period for every block. WASAPI frees room in steps of an engine period,
  so the mixing loop used to mix two blocks within microseconds and every other block was silent; a fixed minimum
  gap after the last mix (Sleep(1) wakes late) still left 5-10% of the blocks silent in a fight. Now 0% silent
  blocks and exactly 187.5 blocks a second; catching up after a stall still keeps two blocks at least 4 ms apart.

---

diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index 6f76df8a..0b509a76 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -189,6 +189,7 @@ static int audio_backend_init(void)
     }
 
     SDL_PauseAudioDevice(s_sdl_audio_dev, 0); /* Start playback */
+    printf("[cellAudio] SDL audio device open: %d Hz, %u channels, format 0x%X\n", have.freq, (unsigned)have.channels, (unsigned)have.format);
     return 0;
 }
 
@@ -553,6 +554,26 @@ static void audio_notify_event_queues(void)
     }
 }
 
+/* The loudest sample of the block just mixed (AUDIO_PEAK). */
+static float audio_mix_peak(void)
+{
+    float pk = 0.0f;
+    for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
+        const float a = s_mix_buffer[i] < 0 ? -s_mix_buffer[i] : s_mix_buffer[i];
+        if (a > pk) pk = a;
+    }
+    return pk;
+}
+
+/* AUDIO_WAV=<file>: append the final mix as raw f32le stereo 48 kHz
+ * (ffmpeg -f f32le -ar 48000 -ac 2 -i <file>). */
+static void audio_dump_mix(void)
+{
+    static FILE* wf = (FILE*)-1;
+    if (wf == (FILE*)-1) { const char* e = getenv("AUDIO_WAV"); wf = e ? fopen(e, "wb") : NULL; }
+    if (wf) fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, wf);
+}
+
 #ifdef _WIN32
 static unsigned __stdcall audio_mix_thread_func(void* arg)
 {
@@ -564,39 +585,55 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
      * WASAPI buffer can never reach, so it mixed ~225 blocks/s and the device
      * dropped the surplus: 20% of the audio thrown away, and a guest mixer
      * (GH3's FMOD) that could not keep ahead of the read index played gaps.
-     * With no device, pace on the performance counter instead. */
-    LARGE_INTEGER qf, q0; QueryPerformanceFrequency(&qf); QueryPerformanceCounter(&q0);
-    unsigned long long blocks = 0;
+     * With no device the clock below is all there is. */
+    LARGE_INTEGER qf; QueryPerformanceFrequency(&qf);
+    /* A device that reports room in coarse steps (WASAPI wakes the loop once per engine period, 10 ms or more) frees
+     * room for two blocks at a time. Mixing both at once leaves the guest no time for the second: the game's audio
+     * thread is woken by the notify below and needs a few ms to write the next block, so every other block was mixed
+     * before it arrived and came out silent -- a 50% crackle.
+     * So the blocks are spaced on an ideal 5.33 ms clock, which gives the guest the whole block period for each next
+     * block. A fixed minimum gap after the previous mix did not: Sleep(1) wakes a millisecond or more late, so a 4 ms
+     * gap left the guest too little time on a busy machine (5-10% of the blocks silent in a Soulcalibur II HD fight
+     * on a 4+4-core laptop) and a 5 ms one fell behind real time (165 blocks a second). The wait is a
+     * high-resolution waitable timer where Windows has one (10 1803+). */
+    const long long period  = qf.QuadPart * CELL_AUDIO_BLOCK_SAMPLES / CELL_AUDIO_SAMPLE_RATE;
+    const long long min_gap = period * 3 / 4;   /* catching up: never two blocks closer than 4 ms */
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+    HANDLE pace_timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                               TIMER_ALL_ACCESS);
+    long long next_due = 0, last_mix = 0;
     while (s_mix_thread_running) {
-        const int room = audio_backend_room();
+        const int room = audio_backend_room();     /* < 0: no device */
         if (room >= 0 && room < CELL_AUDIO_BLOCK_SAMPLES) { audio_backend_wait(); continue; }
-        if (room < 0) {
-            LARGE_INTEGER now; QueryPerformanceCounter(&now);
-            const long long due = q0.QuadPart +
-                (long long)(blocks * CELL_AUDIO_BLOCK_SAMPLES * qf.QuadPart / CELL_AUDIO_SAMPLE_RATE);
-            if (now.QuadPart < due) { Sleep(1); continue; }
-            /* More than 50 ms behind (device just went away, a debugger
-             * stop): drop the backlog instead of mixing it in a burst. */
-            if (now.QuadPart - due > qf.QuadPart / 20)
-                q0.QuadPart = now.QuadPart -
-                    (long long)(blocks * CELL_AUDIO_BLOCK_SAMPLES * qf.QuadPart / CELL_AUDIO_SAMPLE_RATE);
+        LARGE_INTEGER now; QueryPerformanceCounter(&now);
+        const long long due = next_due > last_mix + min_gap ? next_due : last_mix + min_gap;
+        if (now.QuadPart < due) {
+            if (pace_timer) {
+                LARGE_INTEGER rel;
+                rel.QuadPart = -(long long)((due - now.QuadPart) * 10000000 / qf.QuadPart);
+                if (rel.QuadPart >= 0) rel.QuadPart = -1;
+                SetWaitableTimer(pace_timer, &rel, 0, NULL, NULL, FALSE);
+                WaitForSingleObject(pace_timer, 20);
+            } else {
+                Sleep(1);
+            }
+            continue;
         }
-        blocks++;
+        /* More than two blocks behind (a stall, a debugger stop, a device that just went away): restart the clock
+         * rather than mix a burst. */
+        next_due = (now.QuadPart - next_due > 2 * period) ? now.QuadPart + period : next_due + period;
+        last_mix = now.QuadPart;
         /* Mix and submit one block */
         audio_mix_one_block();
         /* AUDIO_PEAK=1: report the mixed block's peak amplitude periodically so
          * "is any port producing sound" is answerable (LBP Bink movie audio). */
         { static int _ap = -1; if (_ap < 0) _ap = getenv("AUDIO_PEAK") ? 1 : 0;
-          if (_ap) { static unsigned _n = 0; float pk = 0.0f;
-            for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
-                float a = s_mix_buffer[i]; if (a < 0) a = -a; if (a > pk) pk = a; }
+          if (_ap) { static unsigned _n = 0; const float pk = audio_mix_peak();
             if ((++_n % 200) == 0 || (pk > 0.001f && _n < 40))
                 fprintf(stderr, "[audio-peak] block#%u peak=%.4f\n", _n, pk); } }
-        /* AUDIO_WAV=<file>: append the final mix as raw f32le stereo 48 kHz
-         * (ffmpeg -f f32le -ar 48000 -ac 2 -i <file>). */
-        { static FILE* _wf = (FILE*)-1;
-          if (_wf == (FILE*)-1) { const char* e = getenv("AUDIO_WAV"); _wf = e ? fopen(e, "wb") : NULL; }
-          if (_wf) fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, _wf); }
+        audio_dump_mix();
         audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
         /* AUDIO_RATE=1: blocks mixed vs real time, and frames dropped. */
         { static int on = -1; if (on < 0) on = getenv("AUDIO_RATE") ? 1 : 0;
@@ -618,6 +655,7 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
         audio_notify_event_queues();
     }
 
+    if (pace_timer) CloseHandle(pace_timer);
     printf("[cellAudio] Mixing thread stopped\n");
     return 0;
 }
@@ -627,10 +665,18 @@ static void* audio_mix_thread_func(void* arg)
     (void)arg;
     printf("[cellAudio] Mixing thread started\n");
 
+    unsigned long blocks = 0; float peak = 0.0f;
     while (s_mix_thread_running) {
         audio_mix_one_block();
         audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
         audio_notify_event_queues();
+        audio_dump_mix();
