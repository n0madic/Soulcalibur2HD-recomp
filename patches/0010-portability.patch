Module access and portability: separate game module, optional LGPL decoder, MinGW GCC.

- Accessor functions for the thread-local state of the PPU trampoline and the SPU context
  (SPU_MODULE_ACCESSORS in spu_context.h, ppu_lifter.py), so a separately built game module can reach it.
- The LGPL-2.1 ATRAC3plus decoder is optional (PS3RECOMP_ATRAC_LGPL, default ON). With it OFF a stub answers
  at3p_open with NULL, so the library has no LGPL code in it.
- ppu_loader.cpp builds with MinGW GCC: the profiling sampler (PS3_SAMPLE_*) reads the sampled thread's stack through
  ReadProcessMemory there (GCC has no structured exception handling), and ppu_resv_break is not declared extern "C"
  and defined static afterwards.

---

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d0363544..61d6d7c5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -76,9 +76,16 @@ endif()
 list(APPEND HLE_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/libs/video/rsx_shader_msl.cpp")
 # cellAtrac decodes with FFmpeg's ATRAC3plus decoder as extracted by PPSSPP
 # (LGPL-2.1, kept separate in third_party/at3_standalone -- see its README).
-file(GLOB AT3_SOURCES "third_party/at3_standalone/*.cpp")
-set_source_files_properties(${AT3_SOURCES} PROPERTIES COMPILE_OPTIONS "-w")  # upstream code
-list(APPEND HLE_SOURCES ${AT3_SOURCES})
+# PS3RECOMP_ATRAC_LGPL=OFF swaps the decoder for a stub that fails every open, which keeps the library and any
+# binary linked from it free of LGPL code (third_party/at3_stub).
+option(PS3RECOMP_ATRAC_LGPL "Link the LGPL-2.1 ATRAC3plus decoder (cellAtrac)" ON)
+if(PS3RECOMP_ATRAC_LGPL)
+    file(GLOB AT3_SOURCES "third_party/at3_standalone/*.cpp")
+    set_source_files_properties(${AT3_SOURCES} PROPERTIES COMPILE_OPTIONS "-w")  # upstream code
+    list(APPEND HLE_SOURCES ${AT3_SOURCES})
+else()
+    list(APPEND HLE_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/third_party/at3_stub/at3_stub.c")
+endif()
 
