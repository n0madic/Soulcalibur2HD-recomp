 static char s_save_root[1024] = "./gamedata/dev_hdd0/home/00000001/savedata";
 
+/* PS3_HDD0_ROOT, when set, is the host directory /dev_hdd0 maps to; keep the saves under it
+ * rather than in whatever directory the process happened to start in. */
+static const char* save_root(void)
+{
+    static int init;
+    if (!init) {
+        init = 1;
+        const char* hdd0 = getenv("PS3_HDD0_ROOT");
+        if (hdd0 && *hdd0)
+            snprintf(s_save_root, sizeof s_save_root, "%s/home/00000001/savedata", hdd0);
+    }
+    return s_save_root;
+}
