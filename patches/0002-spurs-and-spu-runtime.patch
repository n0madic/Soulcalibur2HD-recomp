+/* Every taskset the HLE creates is a workload of the instance, numbered in creation order.
+ * The SPU side reads the id from the taskset (CSTS_WID) and records it when a task parks on
+ * a queue; the real library finds the taskset of a workload in wklInfo1[wid].arg and checks
+ * the workload's bit in wklEnabled, e.g. when it signals a task waiting on a lock-free queue
+ * (_cellSpursLFQueuePushBody). So publish both, like cellSpursAddWorkload does. */
+static u32 spurs_register_taskset_workload(u32 spurs_ea, u32 taskset_ea)
+{
+    struct SpursInst* si = spurs_inst_find(spurs_ea);
+    u32 wid = si ? si->next_taskset_wid++ : 0;
+    if (wid >= CELL_SPURS_MAX_WORKLOAD) wid = CELL_SPURS_MAX_WORKLOAD - 1;
+    vm_write64(spurs_ea + SPURS_WKL_INFO1 + wid * SPURS_WKL_INFO_SZ + 0x08, taskset_ea);
+    vm_write32(spurs_ea + SPURS_WKL_ENABLED,
+               vm_read32(spurs_ea + SPURS_WKL_ENABLED) | (0x80000000u >> wid));
+    /* A push on a fresh lock-free queue signals (workload 0, task 0): the queue's waiting-consumer
+     * slot is still empty and names nothing else. The real kernel's workload 0 is whatever a title
+     * added first; this one is replaced by a taskset that is shut down and recreated at the same
+     * address, and the signal then reaches a taskset without task 0 and the push fails (SRCH).
+     * Keep workload 0 pointing at the newest taskset, which always has the consumer just created. */
+    if (wid) vm_write64(spurs_ea + SPURS_WKL_INFO1 + 0x08, taskset_ea);
+    return wid;
+}
