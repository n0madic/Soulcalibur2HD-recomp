+/* The readback staging buffer, kept and grown rather than allocated per readback: a title copying its picture to
+ * main memory reads 3.6 MB back every frame, and a fresh host allocation of that size each time is not free. */
+static vk_buffer s_rb;
+
 static void vk_eng_batch_reset(void)
 {
     s_eb.vpos = s_eb.ipos = s_eb.upos = s_eb.spos = 0;
@@ -2136,6 +2140,7 @@ static void vk_eb_shutdown(void)
     vk_destroy_buffer(&s_eb.ubo);
     vk_destroy_buffer(&s_eb.stage);
     vk_destroy_buffer(&s_eb.zbuf);
+    vk_destroy_buffer(&s_rb);
     if (s_eb.pool)       pvkDestroyDescriptorPool(s_vk.device, s_eb.pool, NULL);
     if (s_eb.split_pool) pvkDestroyDescriptorPool(s_vk.device, s_eb.split_pool, NULL);
     free(s_eb.vsc);
@@ -2365,15 +2370,114 @@ static void vk_eng_clear_depth_stencil(void* user, u32 depth, u32 flags,
     pvkCmdClearDepthStencilImage(s_vk.cmd, o->im.img, VK_IMAGE_LAYOUT_GENERAL, &d, 1, &r);
 }
 
