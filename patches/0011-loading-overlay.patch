diff --git a/libs/video/rsx_loading_overlay.h b/libs/video/rsx_loading_overlay.h
new file mode 100644
index 00000000..40e8d6c7
--- /dev/null
+++ b/libs/video/rsx_loading_overlay.h
@@ -0,0 +1,73 @@
+/* The "Loading..." text a window backend puts over the picture while the title boots.
+ *
+ * The draw engine decides when it is shown (rsx_draw_engine_loading_overlay); a backend draws it in its window
+ * present, so the guest's own surfaces are never touched. The text is rendered once on the CPU, white on black, in a
+ * 5x7 bitmap font, and handed to the GPU as a small RGBA8 image. */
+#ifndef PS3RECOMP_RSX_LOADING_OVERLAY_H
+#define PS3RECOMP_RSX_LOADING_OVERLAY_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define RSX_LOADING_TEXT_GLYPHS 10u
+#define RSX_LOADING_GLYPH_W     5u
+#define RSX_LOADING_GLYPH_ROWS  8u      /* 7 of cap height, one for the descender of the g */
+#define RSX_LOADING_ADVANCE     6u      /* a glyph and the gap after it */
+#define RSX_LOADING_COLS        (RSX_LOADING_TEXT_GLYPHS * RSX_LOADING_ADVANCE - 1u)
+
+/* The font: "Loading...". Each row is a 5-bit mask, the leftmost pixel in bit 4. */
+static const unsigned char rsx_loading_font[][RSX_LOADING_GLYPH_ROWS] = {
+    { 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x1F, 0x00 },   /* L */
+    { 0x00, 0x00, 0x0E, 0x11, 0x11, 0x11, 0x0E, 0x00 },   /* o */
+    { 0x00, 0x00, 0x0E, 0x01, 0x0F, 0x11, 0x0F, 0x00 },   /* a */
+    { 0x01, 0x01, 0x0F, 0x11, 0x11, 0x11, 0x0F, 0x00 },   /* d */
+    { 0x04, 0x00, 0x0C, 0x04, 0x04, 0x04, 0x0E, 0x00 },   /* i */
+    { 0x00, 0x00, 0x16, 0x19, 0x11, 0x11, 0x11, 0x00 },   /* n */
+    { 0x00, 0x00, 0x0F, 0x11, 0x11, 0x0F, 0x01, 0x0E },   /* g */
+    { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x04, 0x00 },   /* . */
+};
+static const unsigned char rsx_loading_text[RSX_LOADING_TEXT_GLYPHS] = { 0, 1, 2, 3, 4, 5, 6, 7, 7, 7 };
+
+/* Pixels per font pixel for a target `target_h` pixels high: the text is about 2% of the height. */
+static inline unsigned rsx_loading_overlay_scale(unsigned target_h)
+{
+    unsigned s = target_h / 360u;
+    return s < 1u ? 1u : (s > 16u ? 16u : s);
+}
+static inline unsigned rsx_loading_overlay_width(unsigned scale)  { return RSX_LOADING_COLS * scale; }
+static inline unsigned rsx_loading_overlay_height(unsigned scale) { return RSX_LOADING_GLYPH_ROWS * scale; }
+
+/* Renders the text at `scale` into `rgba`, width * height * 4 bytes in R,G,B,A order, tightly packed. */
+static inline void rsx_loading_overlay_render(unsigned char* rgba, unsigned scale)
+{
+    const unsigned w = rsx_loading_overlay_width(scale), h = rsx_loading_overlay_height(scale);
+    for (unsigned y = 0; y < h; y++) {
+        const unsigned row = y / scale;
+        for (unsigned x = 0; x < w; x++) {
+            const unsigned col = x / scale;
+            const unsigned glyph = col / RSX_LOADING_ADVANCE, gx = col % RSX_LOADING_ADVANCE;
+            const int on = gx < RSX_LOADING_GLYPH_W &&
+                           ((rsx_loading_font[rsx_loading_text[glyph]][row] >> (RSX_LOADING_GLYPH_W - 1u - gx)) & 1u);
+            unsigned char* px = rgba + ((size_t)y * w + x) * 4u;
+            px[0] = px[1] = px[2] = on ? 0xFFu : 0x00u;
+            px[3] = 0xFFu;
+        }
+    }
+}
+
+/* Where the text goes on a target `dw` x `dh`: the bottom right corner, the margin of a few font pixels. */
+static inline void rsx_loading_overlay_place(unsigned dw, unsigned dh, unsigned scale, unsigned* x, unsigned* y)
+{
+    const unsigned w = rsx_loading_overlay_width(scale), h = rsx_loading_overlay_height(scale), m = 8u * scale;
+    *x = dw > w + m ? dw - w - m : 0u;
+    *y = dh > h + m ? dh - h - m : 0u;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
