+/* The boot "Loading..." text (rsx_loading_overlay.h): copied over the bottom right corner of the swapchain image after
+ * the blit. It is white on black, so the bytes are the same whether the swapchain is BGRA or RGBA. Every window
+ * submission waits on its fence, so the buffer is idle whenever it is replaced. */
+static vk_buffer s_loading_buf;
+static unsigned  s_loading_scale;
+
+static void vk_window_loading(VkCommandBuffer cmd, u32 idx)
+{
+    const u32 dw = s_vk.sc_extent.width, dh = s_vk.sc_extent.height;
+    const unsigned scale = rsx_loading_overlay_scale(dh);
+    const unsigned w = rsx_loading_overlay_width(scale), h = rsx_loading_overlay_height(scale);
+    if (w > dw || h > dh) return;
+    if (s_loading_scale != scale) {
+        vk_destroy_buffer(&s_loading_buf);
+        s_loading_scale = scale;
+        if (vk_create_host_buffer(&s_loading_buf, (VkDeviceSize)w * h * 4u, VK_BUFFER_USAGE_TRANSFER_SRC_BIT) ||
+            !s_loading_buf.coherent)
+            vk_destroy_buffer(&s_loading_buf);
+        else
+            rsx_loading_overlay_render((unsigned char*)s_loading_buf.ptr, scale);
+    }
+    if (!s_loading_buf.buf) return;
+    unsigned x, y;
+    rsx_loading_overlay_place(dw, dh, scale, &x, &y);
+    VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                           .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT };
+    pvkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+    VkBufferImageCopy region = {
+        .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .imageOffset = { (int32_t)x, (int32_t)y, 0 }, .imageExtent = { w, h, 1 },
+    };
+    pvkCmdCopyBufferToImage(cmd, s_loading_buf.buf, s_vk.sc_images[idx], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+}
+
 /* Records the blit of the offscreen target into swapchain image `idx`, ending with the image ready to present. */
